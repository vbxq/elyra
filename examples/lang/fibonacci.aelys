use std::io
use std::time

// Typed recursive fibonacci for performance (uses specialized opcodes)
fn fib(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

io::print("Fibonacci Sequence ===")
io::print("")

// Calculate first 35 fibonacci numbers
for i in 0..35 {
    io::print("fib(" + i.to_string() + ") = " + fib(i).to_string())
}

// Benchmark fib(35)
io::print("")
io::print("Benchmarking fib(35)...")
let t = time::timer()
let result = fib(35)
let elapsed = time::elapsed_ms(t)
io::print("fib(35) = " + result.to_string())
io::print("Time: " + elapsed.to_string() + " ms")
