use std::io

fn parse_packet() {
    // simulate a binary packet
    let mut packet: Vec<u8> = vec![0; 16]

    // write header (4-byte magic number)
    packet.write_u32_le(0, 0xDEADBEEF)

    // write payload length (2 bytes)
    packet.write_u16_le(4, 1024)

    // write ASCII data
    packet[6] = 65  // 'A'
    packet[7] = 66  // 'B'
    packet[8] = 67  // 'C'

    // parse it back
    let magic = packet.read_u32_le(0)
    let len = packet.read_u16_le(4)
    let text = match packet[6..9].to_utf8() {
        Some(s) => s,
        None => "?",
    }

    io::print("Magic: " + magic.to_string())
    io::print("Length: " + len.to_string())
    io::print("Data: " + text)
}

parse_packet()
