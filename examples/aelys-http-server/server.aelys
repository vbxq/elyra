needs std::net as net
needs std::io
needs print from std::io
needs std::time
needs std::convert as convert

needs config

needs lib::http as http
needs lib::utils as utils
needs lib::router as router

fn handle_client(client: int) -> int {
    let start_time = time::timer()

    let _ = net::set_nodelay(client, true)

    let request_line = net::recv_line(client).unwrap_or("")
    let trimmed = request_line.trim()

    if trimmed.len() == 0 {
        utils::log_error("Empty request received")
        http::send_error(client, 400, "Bad Request: Empty request line")
        let _ = net::close(client)
        return 400
    }

    let method = http::parse_method(request_line)
    let path = http::parse_path(request_line)

    let headers = http::parse_headers(client)

    let status = convert::to_int(router::route_request(client, method, path, headers))

    let _ = net::close(client)

    if convert::to_bool(config::LOG_REQUESTS) {
        let duration = time::elapsed_ms(start_time)
        utils::log_request(method, path, status, duration)
    }

    return status
}

fn start_server() {
    let host = convert::to_string(config::HOST)
    let port = convert::to_int(config::PORT)

    router::init_router()

    let listener = net::listen(host, port).expect("could not start server")

    print("aelys http server")
    print("listening on http://" + host + ":" + convert::to_string(port))
    print("")

    while true {
        match net::accept(listener) {
            Some(client) => handle_client(client),
            None => 0
        }
    }
}

fn main() {
    start_server()
}

main()
