// Multidimensional Arrays Example

needs std::io

io::println("2D Array Example")

// Create a 3x3 matrix
let mut matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]]

// Access elements
io::println("matrix[0][0] = {matrix[0][0]}")
io::println("matrix[1][2] = {matrix[1][2]}")
io::println("matrix[2][1] = {matrix[2][1]}")

// Modify elements
matrix[1][1] = 99
io::println("After modification: matrix[1][1] = {matrix[1][1]}")

// Sum all elements
fn sum_matrix(m) -> int {
    let mut total = 0
    let mut i = 0
    while i < m.len() {
        let mut j = 0
        while j < m[i].len() {
            total += m[i][j]
            j++
        }
        i++
    }
    return total
}

io::println("Sum of all elements: {sum_matrix(matrix)}")

io::println("2D Vec Example")

// Create a grid using vecs (dynamic)
let mut grid = vec![vec![1, 2], vec![3, 4]]
io::println("grid[0][1] = {grid[0][1]}")

// Push to inner vec (vecs are dynamic!)
grid[0].push(5)
io::println("After push: grid[0][2] = {grid[0][2]}")

io::println("3D Array Example")

// Create a 3D cube (2x2x2)
let mut cube = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
io::println("cube[0][0][0] = {cube[0][0][0]}")
io::println("cube[1][1][1] = {cube[1][1][1]}")

cube[0][1][0] = 100
io::println("After modification: cube[0][1][0] = {cube[0][1][0]}")

io::println("Practical Example: Matrix Operations")

// Transpose a 2x3 matrix
fn transpose(m) {
    let rows = m.len()
    let cols = m[0].len()

    // Create result matrix (cols x rows)
    let mut result = vec![]
    let mut i = 0
    while i < cols {
        let mut row = vec![]
        let mut j = 0
        while j < rows {
            row.push(m[j][i])
            j++
        }
        result.push(row)
        i++
    }
    return result
}

let original = [[1, 2, 3], [4, 5, 6]]
io::println("Original matrix:")
io::println("  [{original[0][0]}, {original[0][1]}, {original[0][2]}]")
io::println("  [{original[1][0]}, {original[1][1]}, {original[1][2]}]")

let transposed = transpose(original)
io::println("Transposed matrix:")
io::println("  [{transposed[0][0]}, {transposed[0][1]}]")
io::println("  [{transposed[1][0]}, {transposed[1][1]}]")
io::println("  [{transposed[2][0]}, {transposed[2][1]}]")

io::println("Mixed Types Example")

// Array of vecs
let mixed1 = [vec![1, 2], vec![3, 4, 5]]
io::println("mixed1[1][2] = {mixed1[1][2]}")

// Vec of arrays
let mixed2 = vec![[10, 20], [30, 40]]
io::println("mixed2[0][1] = {mixed2[0][1]}")

io::println("Demo end ")
