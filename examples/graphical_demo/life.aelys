needs std::io
needs std::time
needs std::sys
needs std::convert

let W = 60
let H = 30
let ESC = convert::chr(27)

@no_gc
fn run() {
    let mut grid: Vec<u8> = vec![0; W * H]
    let mut next: Vec<u8> = vec![0; W * H]

    grid.fill(0)

    for i in 0..((W * H) / 4) {
        let x = sys::random_int(0, W - 1).unwrap()
        let y = sys::random_int(0, H - 1).unwrap()
        grid.write_u8(y * W + x, 1)
    }

    let gx = 5
    let gy = 5
    grid.write_u8(gy * W + gx + 1, 1)
    grid.write_u8((gy + 1) * W + gx + 2, 1)
    grid.write_u8((gy + 2) * W + gx, 1)
    grid.write_u8((gy + 2) * W + gx + 1, 1)
    grid.write_u8((gy + 2) * W + gx + 2, 1)

    io::print_inline(ESC + "[?25l")
    io::print_inline(ESC + "[2J")

    for gen in 0..300 {
        io::print_inline(ESC + "[H")
        io::print_inline(ESC + "[97mGen " + convert::to_string(gen) + ESC + "[0m")
        io::print("")

        for y in 0..H {
            for x in 0..W {
                let cell = grid.read_u8(y * W + x)
                if cell == 1 {
                    io::print_inline(ESC + "[42m  " + ESC + "[0m")
                } else {
                    io::print_inline(ESC + "[40m  " + ESC + "[0m")
                }
            }
            io::print("")
        }
        io::flush()

        for y in 0..H {
            for x in 0..W {
                let mut n = 0
                for dy in -1..2 {
                    for dx in -1..2 {
                        if dx != 0 or dy != 0 {
                            let nx = (x + dx + W) % W
                            let ny = (y + dy + H) % H
                            n = n + grid.read_u8(ny * W + nx)
                        }
                    }
                }

                let alive = grid.read_u8(y * W + x)
                let mut new_state = 0
                if alive == 1 and (n == 2 or n == 3) {
                    new_state = 1
                }
                if alive == 0 and n == 3 {
                    new_state = 1
                }
                next.write_u8(y * W + x, new_state)
            }
        }

        for i in 0..W * H { grid[i] = next[i] }
        time::sleep(80)
    }

    io::print_inline(ESC + "[?25h")
    io::print_inline(ESC + "[2J" + ESC + "[H")

}

run()
io::print("Game of Life complete!")
