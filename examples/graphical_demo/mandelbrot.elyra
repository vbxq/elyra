use std::io
use std::time
use std::math

let W = 160
let H = 90
let ROWS = H / 2
let MAX_ITER = 80
let ESC = (27 as char).to_string()
let HALF = (9600 as char).to_string()

fn run() {
    let mut fb: Vec<u8> = vec![0; W * H]
    let mut pal_r: Vec<u8> = vec![0; MAX_ITER + 1]
    let mut pal_g: Vec<u8> = vec![0; MAX_ITER + 1]
    let mut pal_b: Vec<u8> = vec![0; MAX_ITER + 1]

    for i in 0..MAX_ITER {
        let t = (i * 255) / MAX_ITER
        let mut r = 0
        let mut g = 0
        let mut b = 0
        if t < 85 {
            r = t * 3; g = 0; b = t * 3
        } else if t < 170 {
            r = 255; g = (t - 85) * 3; b = 255 - (t - 85) * 3
        } else {
            r = 255; g = 255; b = (t - 170) * 3
        }
        if r > 255 { r = 255 }
        if g > 255 { g = 255 }
        if b > 255 { b = 255 }
        pal_r.write_u8(i, r)
        pal_g.write_u8(i, g)
        pal_b.write_u8(i, b)
    }
    pal_r.write_u8(MAX_ITER, 0)
    pal_g.write_u8(MAX_ITER, 0)
    pal_b.write_u8(MAX_ITER, 0)

    print_inline(ESC + "[?25l")
    print_inline(ESC + "[2J")

    let cx = -0.745
    let cy = 0.186
    let mut zoom = 0.4

    for frame in 0..250 {
        let scale = 2.0 / zoom / (H as float)
        let ox = cx - (W as float / 2.0) * scale
        let oy = cy - (H as float / 2.0) * scale

        for py in 0..H {
            let y0 = oy + py as float * scale
            for px in 0..W {
                let x0 = ox + px as float * scale
                let mut x = 0.0
                let mut y = 0.0
                let mut i = 0
                while i < MAX_ITER && x * x + y * y <= 4.0 {
                    let xt = x * x - y * y + x0
                    y = 2.0 * x * y + y0
                    x = xt
                    i = i + 1
                }
                fb.write_u8(py * W + px, i)
            }
        }

        print_inline(ESC + "[H")
        for row in 0..ROWS {
            let y1 = row * 2
            let y2 = y1 + 1
            for px in 0..W {
                let i1 = fb.read_u8(y1 * W + px)
                let i2 = fb.read_u8(y2 * W + px)
                let r1 = pal_r.read_u8(i1)
                let g1 = pal_g.read_u8(i1)
                let b1 = pal_b.read_u8(i1)
                let r2 = pal_r.read_u8(i2)
                let g2 = pal_g.read_u8(i2)
                let b2 = pal_b.read_u8(i2)
                print_inline(ESC + "[38;2;" + r1.to_string() + ";" + g1.to_string() + ";" + b1.to_string() + ";48;2;" + r2.to_string() + ";" + g2.to_string() + ";" + b2.to_string() + "m" + HALF)
            }
            print_inline(ESC + "[0m")
            println("")
        }
        io::flush()

        zoom = zoom * 1.06
        time::sleep(30)
    }

    print_inline(ESC + "[?25h")
    print_inline(ESC + "[2J" + ESC + "[H")

}

run()
println("Mandelbrot zoom complete!")
