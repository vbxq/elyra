use std::io
use std::time
use std::sys
use std::math

let W = 160
let H = 90
let ROWS = H / 2
let NUM_STARS = 400
let ESC = (27 as char).to_string()
let HALF = (9600 as char).to_string()

@no_gc
fn run() {
    let mut fb_r: Vec<u8> = vec![0; W * H]
    let mut fb_g: Vec<u8> = vec![0; W * H]
    let mut fb_b: Vec<u8> = vec![0; W * H]

    let mut star_x: Vec<u8> = vec![0; NUM_STARS * 4]
    let mut star_y: Vec<u8> = vec![0; NUM_STARS * 4]
    let mut star_z: Vec<u8> = vec![0; NUM_STARS * 4]

    for i in 0..NUM_STARS {
        let x = sys::random_int(-500, 500).unwrap()
        let y = sys::random_int(-500, 500).unwrap()
        let z = sys::random_int(1, 1000).unwrap()
        star_x.write_i32_le(i * 4, x)
        star_y.write_i32_le(i * 4, y)
        star_z.write_i32_le(i * 4, z)
    }

    io::print_inline(ESC + "[?25l")
    io::print_inline(ESC + "[2J")

    let cx = W / 2
    let cy = H / 2
    let speed = 8

    for frame in 0..600 {
        fb_r.fill(0)
        fb_g.fill(0)
        fb_b.fill(0)

        for i in 0..NUM_STARS {
            let mut z = star_z.read_i32_le(i * 4)
            z = z - speed
            if z <= 0 {
                star_x.write_i32_le(i * 4, sys::random_int(-500, 500).unwrap())
                star_y.write_i32_le(i * 4, sys::random_int(-500, 500).unwrap())
                z = 1000
            }
            star_z.write_i32_le(i * 4, z)

            let x = star_x.read_i32_le(i * 4)
            let y = star_y.read_i32_le(i * 4)

            let sx = cx + (x * 200) / z
            let sy = cy + (y * 200) / z

            if sx >= 0 && sx < W && sy >= 0 && sy < H {
                let bright = 255 - (z * 255) / 1000
                let mut b = 0
                if bright > 0 { b = bright }
                if b > 255 { b = 255 }

                let idx = sy * W + sx
                let old = fb_r.read_u8(idx)
                if b > old {
                    fb_r.write_u8(idx, b)
                    fb_g.write_u8(idx, b)
                    fb_b.write_u8(idx, b)
                }

                if z < 300 && sx > 0 && sx < W - 1 {
                    let trail = b / 3
                    let idx1 = sy * W + sx - 1
                    let idx2 = sy * W + sx + 1
                    if fb_r.read_u8(idx1) < trail {
                        fb_r.write_u8(idx1, trail)
                        fb_g.write_u8(idx1, trail)
                        fb_b.write_u8(idx1, trail / 2)
                    }
                    if fb_r.read_u8(idx2) < trail {
                        fb_r.write_u8(idx2, trail)
                        fb_g.write_u8(idx2, trail)
                        fb_b.write_u8(idx2, trail / 2)
                    }
                }
            }
        }

        io::print_inline(ESC + "[H")
        for row in 0..ROWS {
            let y1 = row * 2
            let y2 = y1 + 1
            for px in 0..W {
                let idx1 = y1 * W + px
                let idx2 = y2 * W + px
                let r1 = fb_r.read_u8(idx1)
                let g1 = fb_g.read_u8(idx1)
                let b1 = fb_b.read_u8(idx1)
                let r2 = fb_r.read_u8(idx2)
                let g2 = fb_g.read_u8(idx2)
                let b2 = fb_b.read_u8(idx2)
                io::print_inline(ESC + "[38;2;" + r1.to_string() + ";" + g1.to_string() + ";" + b1.to_string() + ";48;2;" + r2.to_string() + ";" + g2.to_string() + ";" + b2.to_string() + "m" + HALF)
            }
            io::print_inline(ESC + "[0m")
            io::print("")
        }
        io::flush()
        time::sleep(25)
    }

    io::print_inline(ESC + "[?25h")
    io::print_inline(ESC + "[2J" + ESC + "[H")

}

run()
io::print("Starfield complete!")
