use std::io
use std::time
use std::sys

let W = 80
let H = 25
let ESC = (27 as char).to_string()

@no_gc
fn run() {
    let mut fire: Vec<u8> = vec![0; W * H]
    let mut pal_r: Vec<u8> = vec![0; 256]
    let mut pal_g: Vec<u8> = vec![0; 256]
    let mut pal_b: Vec<u8> = vec![0; 256]

    for i in 0..256 {
        let mut r = 0
        let mut g = 0
        let mut b = 0
        if i < 32 {
            r = i * 4
        } else if i < 96 {
            r = 128 + (i - 32) * 2
            g = (i - 32) * 2
        } else {
            r = 255
            g = 128 + (i - 96)
            b = (i - 96) * 2
        }
        if r > 255 { r = 255 }
        if g > 255 { g = 255 }
        if b > 255 { b = 255 }
        pal_r.write_u8(i, r)
        pal_g.write_u8(i, g)
        pal_b.write_u8(i, b)
    }

    io::print_inline(ESC + "[?25l")
    io::print_inline(ESC + "[2J")

    for frame in 0..200 {
        for x in 0..W {
            let v = sys::random_int(180, 255).unwrap()
            fire.write_u8((H - 1) * W + x, v)
        }

        for y in 0..(H - 1) {
            for x in 0..W {
                let mut sum = fire.read_u8((y + 1) * W + x)
                if x > 0 {
                    sum = sum + fire.read_u8((y + 1) * W + x - 1)
                }
                if x < W - 1 {
                    sum = sum + fire.read_u8((y + 1) * W + x + 1)
                }
                if y < H - 2 {
                    sum = sum + fire.read_u8((y + 2) * W + x)
                }
                let mut avg = sum / 4 - sys::random_int(0, 2).unwrap()
                if avg < 0 { avg = 0 }
                fire.write_u8(y * W + x, avg)
            }
        }

        io::print_inline(ESC + "[H")
        for y in 0..H {
            for x in 0..W {
                let v = fire.read_u8(y * W + x)
                let r = pal_r.read_u8(v)
                let g = pal_g.read_u8(v)
                let b = pal_b.read_u8(v)
                io::print_inline(ESC + "[48;2;" + r.to_string() + ";" + g.to_string() + ";" + b.to_string() + "m ")
            }
            io::print_inline(ESC + "[0m")
            io::print("")
        }
        io::flush()
        time::sleep(30)
    }

    io::print_inline(ESC + "[?25h")
    io::print_inline(ESC + "[2J" + ESC + "[H")

}

run()
io::print("Fire demo complete!")
