// clears an SDL2 OpenGL window through the C FFI: aelys run gl_clear.elyra [frames] [hold_ms]
use std::sys as sys

extern "SDL2" {
    fn SDL_Init(flags: u32) -> i32
    fn SDL_GetError() -> cstr
    fn SDL_GL_SetAttribute(attribute: i32, value: i32) -> i32
    fn SDL_CreateWindow(title: cstr, x: i32, y: i32, w: i32, h: i32, flags: u32) -> ptr
    fn SDL_GL_CreateContext(window: ptr) -> ptr
    fn SDL_GL_SwapWindow(window: ptr)
    fn SDL_GL_DeleteContext(context: ptr)
    fn SDL_PollEvent(event: &mut [u8]) -> i32
    fn SDL_Delay(ms: u32)
    fn SDL_DestroyWindow(window: ptr)
    fn SDL_Quit()
}

extern "GL" {
    fn glGetString(name: u32) -> cstr
    fn glViewport(x: i32, y: i32, w: i32, h: i32)
    fn glClearColor(r: f32, g: f32, b: f32, a: f32)
    fn glClear(mask: u32)
    fn glFinish()
    fn glReadPixels(x: i32, y: i32, w: i32, h: i32, format: u32, kind: u32, data: &mut [u8])
}

let SDL_INIT_VIDEO: u32 = 0x20
let SDL_WINDOW_OPENGL: u32 = 0x2
let SDL_GL_DOUBLEBUFFER = 5
let GL_RENDERER: u32 = 0x1F01
let GL_COLOR_BUFFER_BIT: u32 = 0x4000
let GL_RGBA: u32 = 0x1908
let GL_UNSIGNED_BYTE: u32 = 0x1401
let W = 320
let H = 240

fn arg_or(index: int, fallback: int) -> int {
    match sys::arg(index) {
        Some(text) => text.to_int().unwrap_or(fallback),
        None => fallback,
    }
}

fn fail(what: string) -> unit {
    println("{what} failed: {SDL_GetError()}")
    sys::exit(1)
}

if SDL_Init(SDL_INIT_VIDEO) != 0 { fail("SDL_Init") }
SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1)
let window = SDL_CreateWindow("Elyra GL", 100, 100, W, H, SDL_WINDOW_OPENGL)
if window.is_null() { fail("SDL_CreateWindow") }
let context = SDL_GL_CreateContext(window)
if context.is_null() { fail("SDL_GL_CreateContext") }
println("renderer: {glGetString(GL_RENDERER)}")

let frames = arg_or(0, 60)
let hold_ms = arg_or(1, 0)
let mut event: Vec<u8> = vec![0; 64]
let mut pixel: Vec<u8> = vec![0; 4]
glViewport(0, 0, W, H)
let mut frame = 0
while frame < frames {
    let t = frame as float / frames as float
    glClearColor(0.25, t as f32, 0.75, 1.0)
    glClear(GL_COLOR_BUFFER_BIT)
    glFinish()
    glReadPixels(W / 2, H / 2, 1, 1, GL_RGBA, GL_UNSIGNED_BYTE, &mut pixel)
    SDL_GL_SwapWindow(window)
    while SDL_PollEvent(&mut event) != 0 {}
    frame += 1
}
println("last clear rgba {pixel[0]} {pixel[1]} {pixel[2]} {pixel[3]}")
if hold_ms > 0 { SDL_Delay(hold_ms as u32) }
SDL_GL_DeleteContext(context)
SDL_DestroyWindow(window)
SDL_Quit()
