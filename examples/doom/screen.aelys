needs sdl
needs render

let mut palette: Vec<u8> = vec![0; 768]

pub fn open(title: string, playpal: Vec<int>, scale: int) -> Result<(), string> {
    for i in 0..768 { palette[i] = playpal[i] as u8 }
    sdl::open(title, 320, 200, scale)
}

pub fn present() -> bool {
    let pixels = render::framebuffer()
    let uploaded = sdl::present_indexed(&pixels, &palette)
    let mut quit = false
    let mut ev = sdl::poll()
    while ev != 0 {
        if ev == 1 { quit = true }
        ev = sdl::poll()
    }
    uploaded.is_ok() and not quit
}

pub fn close() { sdl::close() }
