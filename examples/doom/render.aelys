fn iabs(a: int) -> int {
    if a < 0 { -a } else { a }
}

@inline_always
fn ang(a: int) -> int { a & 0xFFFFFFFF }

@inline_always
fn ang_add(a: int, b: int) -> int { (a + b) & 0xFFFFFFFF }

@inline_always
fn ang_sub(a: int, b: int) -> int { (a - b) & 0xFFFFFFFF }

@inline_always
fn fine_index(a: int) -> int { (a & 0xFFFFFFFF) >> 19 }

fn fdiv(a: int, b: int) -> int {
    let aa = if a < 0 { -a } else { a }
    let ab = if b < 0 { -b } else { b }
    if (aa >> 14) >= ab {
        if (a ^ b) < 0 { return -2147483648 }
        return 2147483647
    }
    a.shl_div(b, 16)
}

fn name_slot(name: string) -> int {
    let k = wad::key_of(name)
    ((k.lo * 31 + k.hi) % 4093 + 4093) % 4093
}

fn build_index(names: Vec<string>) -> Vec<int> {
    let mut slots: Vec<int> = vec![0; 4096]
    for i in 0..names.len() {
        let mut s = name_slot(names[i])
        while slots[s] != 0 and names[slots[s] - 1] != names[i] {
            s = (s + 1) % 4096
        }
        if slots[s] == 0 { slots[s] = i + 1 }
    }
    slots
}

fn find_index(slots: Vec<int>, names: Vec<string>, name: string) -> int {
    let mut s = name_slot(name)
    while slots[s] != 0 {
        let i = slots[s] - 1
        if names[i] == name { return i }
        s = (s + 1) % 4096
    }
    -1
}

fn texture_num(slots: Vec<int>, names: Vec<string>, name: string) -> int {
    if name == "-" { return 0 }
    let i = find_index(slots, names, name)
    if i < 0 { 0 } else { i }
}

fn empty_picture() -> Picture {
    let col: Vec<int> = vec![0; 17]
    Picture { width: 1, height: 1, left: 0, top: 0, widthmask: 0, heightmask: 0, cols: vec![col], mcols: vec![col], colpost: vec![0], posts: vec![-1] }
}

fn pow2_mask(n: int) -> int {
    let mut j = 1
    while j * 2 <= n { j = j * 2 }
    j - 1
}

fn posts_from_mask(width: int, height: int, opaque: Vec<int>) -> Picture {
    let mut colpost: Vec<int> = vec![0; width]
    let mut posts: Vec<int> = vec![]
    for x in 0..width {
        colpost[x] = posts.len()
        let base = x * height
        let mut y = 0
        while y < height {
            if opaque[base + y] != 0 {
                let top = y
                while y < height and opaque[base + y] != 0 { y++ }
                posts.push(top)
                posts.push(y - top)
                posts.push(8 + top)
            } else {
                y++
            }
        }
        posts.push(-1)
    }
    let hm = if pow2_mask(height) + 1 == height { height - 1 } else { -1 }
    let none: Vec<Vec<int>> = vec![]
    Picture { width: width, height: height, left: 0, top: 0, widthmask: pow2_mask(width), heightmask: hm, cols: none, mcols: none, colpost: colpost, posts: posts }
}

fn build_texture(w: Wad, g: Graphics, tex: TextureDef) -> Picture {
    let width = tex.width
    let height = tex.height
    let n = width * height
    let mut pix: Vec<int> = vec![0; n + 512]
    let mut opaque: Vec<int> = vec![0; n]
    for pr in tex.patches {
        let li = g.patch_lumps[pr.patch]
        if li < 0 { continue }
        let patch = gfx::decode_patch(w, li)
        for x in 0..patch.width {
            let tx = pr.origin_x + x
            if tx < 0 or tx >= width { continue }
            let col = tx * height
            for post in patch.columns[x] {
                let y0 = pr.origin_y + post.top
                for i in 0..post.length {
                    let ty = y0 + i
                    if ty >= 0 and ty < height {
                        pix[256 + col + ty] = bytes::read_u8(w.buf, post.data + i)
                        opaque[col + ty] = 1
                    }
                }
            }
        }
    }
    let p = posts_from_mask(width, height, opaque)
    let mut cols: Vec<Vec<int>> = vec![]
    let mut mcols: Vec<Vec<int>> = vec![]
    for x in 0..width {
        let mut c: Vec<int> = vec![0; height]
        let mut m: Vec<int> = vec![0; height + 16]
        for y in 0..height {
            c[y] = pix[256 + x * height + y]
            m[8 + y] = c[y]
        }
        cols.push(c)
        mcols.push(m)
    }
    Picture { width: width, height: height, left: 0, top: 0, widthmask: p.widthmask, heightmask: p.heightmask, cols: cols, mcols: mcols, colpost: p.colpost, posts: p.posts }
}

fn build_patch(w: Wad, li: int) -> Picture {
    let patch = gfx::decode_patch(w, li)
    let width = patch.width
    let mut height = patch.height
    for x in 0..width {
        for post in patch.columns[x] {
            if post.top + post.length > height { height = post.top + post.length }
        }
    }
    let mut mcols: Vec<Vec<int>> = vec![]
    let mut colpost: Vec<int> = vec![0; width]
    let mut posts: Vec<int> = vec![]
    for x in 0..width {
        colpost[x] = posts.len()
        let mut m: Vec<int> = vec![0; height + 16]
        for post in patch.columns[x] {
            posts.push(post.top)
            posts.push(post.length)
            posts.push(8 + post.top)
            for i in 0..post.length {
                m[8 + post.top + i] = bytes::read_u8(w.buf, post.data + i)
            }
        }
        posts.push(-1)
        mcols.push(m)
    }
    let none: Vec<Vec<int>> = vec![]
    Picture { width: width, height: height, left: patch.left, top: patch.top, widthmask: pow2_mask(width), heightmask: -1, cols: none, mcols: mcols, colpost: colpost, posts: posts }
}

fn push_int(mut v: Vec<int>, x: int) { v.push(x) }

