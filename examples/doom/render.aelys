}

fn sprite_picture(w: Wad, lump: int, mut lump_pic: Vec<int>) -> int {
    if lump_pic[lump] < 0 {
        lump_pic[lump] = sprite_pics.len()
        sprite_pics.push(build_patch(w, lump))
    }
    lump_pic[lump]
}

fn find_sprite_def(w: Wad, first: int, last: int, sprite: string, frame: int, lump_pic: Vec<int>) -> int {
    let mut pics = [-1, -1, -1, -1, -1, -1, -1, -1]
    let mut flips = [0, 0, 0, 0, 0, 0, 0, 0]
    let mut rotate = true
    let fchar = frame + 65
    for li in (first + 1)..last {
        let name = w.lumps[li].name
        if name.len() < 6 or name.substr(0, 4) != sprite { continue }
        if name.byte_at(4) == fchar {
            let rot = name.byte_at(5) - 48
            let pic = sprite_picture(w, li, lump_pic)
            if rot == 0 {
                rotate = false
                for r in 0..8 { pics[r] = pic; flips[r] = 0 }
            } else {
                if rot >= 1 and rot <= 8 { pics[rot - 1] = pic; flips[rot - 1] = 0 }
            }
        }
        if name.len() >= 8 and name.byte_at(6) == fchar {
            let rot = name.byte_at(7) - 48
            let pic = sprite_picture(w, li, lump_pic)
            if rot == 0 {
                rotate = false
                for r in 0..8 { pics[r] = pic; flips[r] = 1 }
            } else {
                if rot >= 1 and rot <= 8 { pics[rot - 1] = pic; flips[rot - 1] = 1 }
            }
        }
    }
    if pics[0] < 0 { return -1 }
    for r in 0..8 {
        if pics[r] < 0 { pics[r] = pics[0]; flips[r] = flips[0] }
    }
    sprite_defs.push(SpriteDef { rotate: rotate, pics: pics, flips: flips })
    sprite_defs.len() - 1
}

fn node_side(x: int, y: int, node: Node) -> int {
    let nx = node.x << 16
    let ny = node.y << 16
    let ndx = node.dx
    let ndy = node.dy
    if ndx == 0 {
        if x <= nx { return if ndy > 0 { 1 } else { 0 } }
        return if ndy < 0 { 1 } else { 0 }
    }
    if ndy == 0 {
        if y <= ny { return if ndx < 0 { 1 } else { 0 } }
        return if ndx > 0 { 1 } else { 0 }
    }
    let dx = x - nx
    let dy = y - ny
    if (ndy ^ ndx ^ dx ^ dy) < 0 {
        if (ndy ^ dx) < 0 { return 1 }
        return 0
    }
    let left = (ndy * dx) >> 16
    let right = (dy * ndx) >> 16
    if right < left { 0 } else { 1 }
}

fn point_in_subsector(x: int, y: int) -> int {
    let mut n = num_nodes - 1
    while true {
        let node = nodes[n]
        let c: Child = if node_side(x, y, node) == 0 { node.right } else { node.left }
        match c {
            Child::Leaf(i) => { return i },
            Child::Node(i) => { n = i },
        }
    }
    0
}

fn init_lights() {
    for i in 0..16 {
        let startmap = ((15 - i) * 2) * 32 / 16
        for j in 0..128 {
            let scale = fdiv(160 << 16, (j + 1) << 20) >> 12
            let mut level = startmap - scale / 2
            if level < 0 { level = 0 }
            if level > 31 { level = 31 }
            zlight[i * 128 + j] = level
        }
        for j in 0..48 {
            let mut level = startmap - j * 320 / 320 / 2
            if level < 0 { level = 0 }
            if level > 31 { level = 31 }
            scalelight[i * 48 + j] = level
        }
    }
    for i in 0..200 {
        let dy = iabs(((i - 100) << 16) + 32768)
        yslope[i] = fdiv(160 << 16, dy)
    }
    for i in 0..320 {
        let cosadj = iabs(fixed::finesine[(fixed::xtoviewangle[i] >> 19) + 2048])
        distscale[i] = fdiv(65536, cosadj)
    }
    checkcoord = vec![3, 0, 2, 1, 3, 0, 2, 0, 3, 1, 2, 0, 0, 0, 0, 0, 2, 0, 2, 1, 0, 0, 0, 0, 3, 1, 3, 0, 0, 0, 0, 0, 2, 0, 3, 1, 2, 1, 3, 1, 2, 1, 3, 0]
    for i in 0..320 {
        openings[i] = 200
        openings[320 + i] = -1
    }
}

pub fn setup(w: Wad, g: Graphics, lv: Level) {
    let t0 = time::timer()
    cmap_rows = vec![]
    for m in 0..(g.colormap.len() / 256) {
        let mut row: Vec<int> = vec![0; 256]
        for i in 0..256 { row[i] = g.colormap[m * 256 + i] }
        cmap_rows.push(row)
    }
    init_lights()
    let mut tex_names: Vec<string> = vec![]
    tex_heights = vec![]
    tex_pics = vec![]
    let dummy = empty_picture()
    for t in g.textures {
        tex_names.push(t.name)
        tex_heights.push(t.height << 16)
        tex_pics.push(dummy)
    }
    let tex_slots = build_index(tex_names)
    let mut flat_names: Vec<string> = vec![]
    let no_flat: Vec<int> = vec![]
    flat_pix = vec![]
    for f in g.flats {
        flat_names.push(f.name)
        flat_pix.push(no_flat)
    }
    let flat_slots = build_index(flat_names)
    sky_flat = find_index(flat_slots, flat_names, "F_SKY1")
    sky_tex = texture_num(tex_slots, tex_names, "SKY1")

    let mut tex_used: Vec<int> = vec![0; g.textures.len()]
    tex_used[sky_tex] = 1
    sides = vec![]
    for sd in lv.sidedefs {
        let top = texture_num(tex_slots, tex_names, sd.upper)
        let mid = texture_num(tex_slots, tex_names, sd.middle)
        let bottom = texture_num(tex_slots, tex_names, sd.lower)
        tex_used[top] = 1
        tex_used[mid] = 1
        tex_used[bottom] = 1
        sides.push(WallSide { xoff: sd.xoff << 16, yoff: sd.yoff << 16, top: top, mid: mid, bottom: bottom, sector: sd.sector })
    }
    let mut ntex = 0
    for i in 0..g.textures.len() {
        if tex_used[i] != 0 {
            tex_pics[i] = build_texture(w, g, g.textures[i])
            ntex++
        }
    }
    rooms = vec![]
    sector_actors = vec![]
    sector_stamp = vec![0; lv.sectors.len()]
    let mut nflat = 0
    for s in lv.sectors {
        let fp = find_index(flat_slots, flat_names, s.floor_flat)
        let cp = find_index(flat_slots, flat_names, s.ceil_flat)
        rooms.push(Room { floor: s.floor_h << 16, ceil: s.ceil_h << 16, floorpic: fp, ceilpic: cp, light: s.light })
        let fresh: Vec<int> = vec![]
        sector_actors.push(fresh)
        if fp >= 0 and flat_pix[fp].len() == 0 { flat_pix[fp] = gfx::flat_pixels(w, g.flats[fp]); nflat++ }
        if cp >= 0 and flat_pix[cp].len() == 0 { flat_pix[cp] = gfx::flat_pixels(w, g.flats[cp]); nflat++ }
    }
    segs = vec![]
    for s in lv.segs {
        let ld = lv.linedefs[s.linedef]
        let sdi = if s.direction == 0 { ld.front } else { ld.back }
        let other = if s.direction == 0 { ld.back } else { ld.front }
        let mut back = -1
        if (ld.flags & 4) != 0 and other >= 0 { back = sides[other].sector }
        let v1 = lv.vertexes[s.v1]
        let v2 = lv.vertexes[s.v2]
        segs.push(WallSeg {
            x1: v1.x << 16,
            y1: v1.y << 16,
            x2: v2.x << 16,
            y2: v2.y << 16,
            angle: (s.angle << 16) & 0xFFFFFFFF,
            offset: s.offset << 16,
            side: sdi,
            flags: ld.flags,
            front: sides[sdi].sector,
            back: back,
        })
    }
    sub_first = vec![]
    sub_count = vec![]
    sub_sector = vec![]
    for ss in lv.subsectors {
        sub_first.push(ss.first_seg)
        sub_count.push(ss.count)
        sub_sector.push(segs[ss.first_seg].front)
    }
    nodes = lv.nodes
    num_nodes = nodes.len()

    let s_first = w.find_lump("S_START")
    let s_last = w.find_lump("S_END")
    let mut lump_pic: Vec<int> = vec![-1; w.num_lumps()]
    let mut kind_def: Vec<int> = vec![-2; 4096]
    actors = vec![]
    skipped_things = 0
    for t in lv.things {
        if t.kind >= 1 and t.kind <= 4 { continue }
        if t.kind == 11 { continue }
        if (t.flags & 16) != 0 { continue }
        if (t.flags & 2) == 0 { continue }
        let kind = t.kind & 4095
        if kind_def[kind] == -2 {
            let k = thing_kind(t.kind)
            if k.sprite == "" {
                kind_def[kind] = -1
            } else {
                kind_def[kind] = find_sprite_def(w, s_first, s_last, k.sprite, k.frame, lump_pic)
            }
        }
        let def = kind_def[kind]
        if def < 0 { skipped_things++; continue }
        let x = t.x << 16
        let y = t.y << 16
        let sector = sub_sector[point_in_subsector(x, y)]
        let room = rooms[sector]
        let hang = hang_height(t.kind)
        let z = if hang > 0 { room.ceil - (hang << 16) } else { room.floor }
        let k = thing_kind(t.kind)
        actors.push(Actor { x: x, y: y, z: z, angle: (0x20000000 * (t.angle / 45)) & 0xFFFFFFFF, def: def, bright: k.bright, sector: sector })
        push_int(sector_actors[sector], actors.len() - 1)
    }
    println("render setup: {ntex} textures, {nflat} flats, {actors.len()} things ({skipped_things} unknown), {sprite_pics.len()} sprite patches, {time::elapsed(t0) * 1000.0} ms")
}

pub fn framebuffer() -> Vec<int> { fb }

pub fn floor_height_at(x: int, y: int) -> int {
    rooms[sub_sector[point_in_subsector(x, y)]].floor
}

fn point_to_angle(px: int, py: int) -> int {
    let mut x = px - viewx
    let mut y = py - viewy
    if x == 0 and y == 0 { return 0 }
    let mut base = 0
    let mut neg = false
    let mut num = y
    let mut den = x
    if x >= 0 {
        if y >= 0 {
            if x <= y {
                base = 0x3FFFFFFF
                neg = true
                num = x
                den = y
            }
        } else {
            y = -y
            num = y
            if x > y {
                base = 0x100000000
                neg = true
            } else {
                base = 0xC0000000
                num = x
                den = y
            }
        }
    } else {
        x = -x
        den = x
        if y >= 0 {
            if x > y {
                base = 0x7FFFFFFF
                neg = true
            } else {
                base = 0x40000000
                num = x
                den = y
            }
        } else {
            y = -y
            num = y
            if x > y {
                base = 0x80000000
            } else {
                base = 0xBFFFFFFF
                neg = true
                num = x
                den = y
            }
        }
    }
    let mut slope = 2048
    if den >= 512 {
        slope = (num << 3) / (den >> 8)
        if slope > 2048 { slope = 2048 }
    }
    if neg { (base - fixed::tantoangle[slope]) & 0xFFFFFFFF } else { base + fixed::tantoangle[slope] }
}

fn point_to_dist(px: int, py: int) -> int {
    let mut dx = px - viewx
    let mut dy = py - viewy
    if dx < 0 { dx = -dx }
    if dy < 0 { dy = -dy }
    if dy > dx {
        let t = dx
        dx = dy
        dy = t
    }
    if dx == 0 { return 0 }
    let slope = (dy / dx) * 65536 + ((dy % dx) * 65536) / dx
    let sine = fixed::finesine[(fixed::tantoangle[slope >> 5] + 0x40000000) >> 19]
    if (dx >> 14) >= sine { return 2147483647 }
    (dx / sine) * 65536 + ((dx % sine) * 65536) / sine
}

fn scale_from_angle(visangle: int, normalangle: int, distance: int) -> int {
    let anglea = (0x40000000 + visangle - viewangle) & 0xFFFFFFFF
    let angleb = (0x40000000 + visangle - normalangle) & 0xFFFFFFFF
    let sinea = fixed::finesine[anglea >> 19]
    let sineb = fixed::finesine[angleb >> 19]
    let num = 160 * sineb
    let dl = distance & 0xFFFF
    let den = (distance >> 16) * sinea + dl * (sinea >> 16) + ((dl * (sinea & 0xFFFF)) >> 16)
    if den > (num >> 16) {
        let an = if num < 0 { -num } else { num }
        let ad = if den < 0 { -den } else { den }
        let mut scale = 2147483647
        if (an >> 14) >= ad {
            if (num ^ den) < 0 { scale = -2147483648 }
        } else {
            scale = (num / den) * 65536 + ((num % den) * 65536) / den
        }
        if scale > 4194304 { scale = 4194304 }
        if scale < 256 { scale = 256 }
        return scale
    }
    4194304
}

fn find_plane(height: int, pic: int, light: int) -> int {
    let mut h = height
    let mut l = light
    if pic == sky_flat {
        h = 0
        l = 0
    }
    for i in 0..num_planes {
        if pl_height[i] == h and pl_pic[i] == pic and pl_light[i] == l { return i }
    }
    if num_planes >= 128 { return -1 }
    let p = num_planes
    num_planes++
    pl_height[p] = h
    pl_pic[p] = pic
    pl_light[p] = l
    pl_minx[p] = 320
    pl_maxx[p] = -1
    p
}

fn check_plane(p: int, start: int, stop: int) -> int {
    let minx = pl_minx[p]
    let maxx = pl_maxx[p]
    let mut intrl = start
    let mut unionl = minx
    if start < minx {
        intrl = minx
        unionl = start
    }
    let mut intrh = stop
    let mut unionh = maxx
    if stop > maxx {
        intrh = maxx
        unionh = stop
    }
    let base = p * 322 + 1
    let mut x = intrl
    while x <= intrh {
        if pl_top[base + x] != 255 { break }
        x++
    }
    if x > intrh {
        pl_minx[p] = unionl
        pl_maxx[p] = unionh
        return p
    }
    if num_planes >= 128 { return p }
    let n = num_planes
    num_planes++
    pl_height[n] = pl_height[p]
    pl_pic[n] = pl_pic[p]
    pl_light[n] = pl_light[p]
    pl_minx[n] = start
    pl_maxx[n] = stop
    n
}

fn draw_column(mut out: Vec<int>, cmrow: Vec<int>, col: Vec<int>, x: int, yl: int, yh: int, texturemid: int, iscale: int, mask: int, height: int) {
    if yh >= yl {
        let mut frac = texturemid + (yl - 100) * iscale
        if mask >= 0 {
            for d in (yl * 320 + x)..=(yh * 320 + x) step 320 {
                out[d] = cmrow[col[(frac >> 16) & mask]]
                frac += iscale
            }
        } else {
            let hf = height << 16
            frac = frac % hf
            if frac < 0 { frac += hf }
            for d in (yl * 320 + x)..=(yh * 320 + x) step 320 {
                out[d] = cmrow[col[frac >> 16]]
                frac += iscale
                if frac >= hf { frac -= hf }
            }
        }
    }
}

fn draw_masked_column(pic: Picture, c: int, x: int, topscreen0: int, yscale: int, basemid: int, iscale: int, cmrow: Vec<int>, ceilclip: int, floorclip_v: int) {
    let posts = pic.posts
    let col = pic.mcols[c]
    let mut p = pic.colpost[c]
    while posts[p] >= 0 {
        let topdelta = posts[p]
        let topscreen = topscreen0 + yscale * topdelta
        let mut yl = (topscreen + 65535) >> 16
        let mut yh = (topscreen + yscale * posts[p + 1] - 1) >> 16
        if yh >= floorclip_v { yh = floorclip_v - 1 }
        if yl <= ceilclip { yl = ceilclip + 1 }
        if yl <= yh {
            let data = posts[p + 2]
            let mut frac = basemid - (topdelta << 16) + (yl - 100) * iscale
            for d in (yl * 320 + x)..=(yh * 320 + x) step 320 {
                fb[d] = cmrow[col[data + (frac >> 16)]]
                frac += iscale
            }
        }
        p += 3
    }
}

fn wall_angles(seg: WallSeg, start: int, stop: int) {
    let normalangle = (seg.angle + 0x40000000) & 0xFFFFFFFF
    w_normal = normalangle
    let mut offsetangle = (normalangle - rw_angle1) & 0xFFFFFFFF
    if offsetangle >= 0x80000000 { offsetangle = 0x100000000 - offsetangle }
    if offsetangle > 0x40000000 { offsetangle = 0x40000000 }
    let distangle = 0x40000000 - offsetangle
    w_hyp = point_to_dist(seg.x1, seg.y1)
    w_distance = fmul(w_hyp, fixed::finesine[distangle >> 19])
    let xtov = fixed::xtoviewangle
    w_scale1 = scale_from_angle((viewangle + xtov[start]) & 0xFFFFFFFF, normalangle, w_distance)
    w_scale2 = w_scale1
    w_scalestep = 0
    if stop > start {
        w_scale2 = scale_from_angle((viewangle + xtov[stop]) & 0xFFFFFFFF, normalangle, w_distance)
        w_scalestep = (w_scale2 - w_scale1) / (stop - start)
    }
}

fn wall_one_sided(seg: WallSeg, side: WallSide, front: Room) {
    w_midtex = side.mid
    w_markfloor = true
    w_markceiling = true
    if (seg.flags & 16) != 0 {
        w_midtexmid = front.floor + tex_heights[side.mid] - viewz + side.yoff
    } else {
        w_midtexmid = front.ceil - viewz + side.yoff
    }
    w_sil = 3
    w_topclip = 0
    w_botclip = 320
    w_bsil = 2147483647
    w_tsil = -2147483648
}

fn wall_two_sided(seg: WallSeg, side: WallSide, front: Room, back: Room, start: int, stopx: int) {
    if front.floor > back.floor {
        w_sil = 1
        w_bsil = front.floor
    } else {
        if back.floor > viewz {
            w_sil = 1
            w_bsil = 2147483647
        }
    }
    if front.ceil < back.ceil {
        w_sil = w_sil | 2
        w_tsil = front.ceil
    } else {
        if back.ceil < viewz {
            w_sil = w_sil | 2
            w_tsil = -2147483648
        }
    }
    if back.ceil <= front.floor {
        w_botclip = 320
        w_bsil = 2147483647
        w_sil = w_sil | 1
    }
    if back.floor >= front.ceil {
        w_topclip = 0
        w_tsil = -2147483648
        w_sil = w_sil | 2
    }
    w_worldhigh = back.ceil - viewz
    w_worldlow = back.floor - viewz
    if front.ceilpic == sky_flat and back.ceilpic == sky_flat { w_worldtop = w_worldhigh }
    w_markfloor = w_worldlow != w_worldbottom or back.floorpic != front.floorpic or back.light != front.light
    w_markceiling = w_worldhigh != w_worldtop or back.ceilpic != front.ceilpic or back.light != front.light
    if back.ceil <= front.floor or back.floor >= front.ceil {
        w_markceiling = true
        w_markfloor = true
    }
    if w_worldhigh < w_worldtop {
        w_toptex = side.top
        if (seg.flags & 8) != 0 {
            w_toptexmid = w_worldtop + side.yoff
        } else {
            w_toptexmid = back.ceil + tex_heights[side.top] - viewz + side.yoff
        }
    }
    if w_worldlow > w_worldbottom {
        w_bottomtex = side.bottom
        if (seg.flags & 16) != 0 {
            w_bottomtexmid = w_worldtop + side.yoff
        } else {
            w_bottomtexmid = w_worldlow + side.yoff
        }
    }
    if side.mid != 0 {
        w_masked = true
        w_masked_base = lastopening - start
        lastopening += stopx - start
    }
}

fn wall_texturing(seg: WallSeg, side: WallSide, front: Room) {
    let delta = (w_normal - rw_angle1) & 0xFFFFFFFF
    let mut oa = delta
    if oa > 0x80000000 { oa = 0x100000000 - oa }
    if oa > 0x40000000 { oa = 0x40000000 }
    let mut off = fmul(w_hyp, fixed::finesine[oa >> 19])
    if delta < 0x80000000 { off = -off }
    w_offset = off + side.xoff + seg.offset
    w_centerangle = (0x40000000 + viewangle - w_normal) & 0xFFFFFFFF
    let mut lightnum = front.light >> 4
    if seg.y1 == seg.y2 {
        lightnum--
    } else {
        if seg.x1 == seg.x2 { lightnum++ }
    }
    if lightnum < 0 { lightnum = 0 }
    if lightnum > 15 { lightnum = 15 }
    w_lightrow = lightnum * 48
}

fn wall_steps(has_back: bool) {
    let top = w_worldtop >> 4
    let bottom = w_worldbottom >> 4
    w_topstep = -fmul(w_scalestep, top)
    w_topfrac = 409600 - fmul(top, w_scale1)
    w_bottomstep = -fmul(w_scalestep, bottom)
    w_bottomfrac = 409600 - fmul(bottom, w_scale1)
    w_pixhigh = 0
    w_pixhighstep = 0
    w_pixlow = 0
    w_pixlowstep = 0
    if has_back {
        let high = w_worldhigh >> 4
        let low = w_worldlow >> 4
        if high < top {
            w_pixhigh = 409600 - fmul(high, w_scale1)
            w_pixhighstep = -fmul(w_scalestep, high)
        }
        if low > bottom {
            w_pixlow = 409600 - fmul(low, w_scale1)
            w_pixlowstep = -fmul(w_scalestep, low)
        }
    }
}

fn store_wall_range(start: int, stop: int) {
    if num_ds >= 256 { return () }
    let seg = segs[cur_seg]
    let side = sides[seg.side]
    let front = rooms[cur_front]
    let has_back = cur_back >= 0
    wall_angles(seg, start, stop)
    w_worldtop = front.ceil - viewz
    w_worldbottom = front.floor - viewz
    w_worldhigh = 0
    w_worldlow = 0
    w_midtex = 0
    w_toptex = 0
    w_bottomtex = 0
    w_masked = false
    w_masked_base = -1000000
    w_midtexmid = 0
    w_toptexmid = 0
    w_bottomtexmid = 0
    w_sil = 0
    w_bsil = 0
    w_tsil = 0
    w_topclip = -1000000
    w_botclip = -1000000
    if has_back {
        wall_two_sided(seg, side, front, rooms[cur_back], start, stop + 1)
    } else {
        wall_one_sided(seg, side, front)
    }
    w_segtextured = w_midtex != 0 or w_toptex != 0 or w_bottomtex != 0 or w_masked
    if w_segtextured { wall_texturing(seg, side, front) }
    if front.floor >= viewz { w_markfloor = false }
    if front.ceil <= viewz and front.ceilpic != sky_flat { w_markceiling = false }
    if floorplane < 0 { w_markfloor = false }
    if ceilingplane < 0 { w_markceiling = false }
    wall_steps(has_back)
    if w_markceiling { ceilingplane = check_plane(ceilingplane, start, stop) }
    if w_markfloor { floorplane = check_plane(floorplane, start, stop) }
    seg_loop(fb, start, stop + 1, 16)
    wall_finish(start, stop)
}

fn seg_loop(mut out: Vec<int>, start: int, stopx: int, sh: int) {
    let markceiling = w_markceiling
    let markfloor = w_markfloor
    let segtextured = w_segtextured
    let midtex = w_midtex
    let toptex = w_toptex
    let bottomtex = w_bottomtex
    let masked = w_masked
    let masked_base = w_masked_base
    let cbase = ceilingplane * 322 + 1
    let fbase = floorplane * 322 + 1
    let ftan = fixed::finetangent
    let xtov = fixed::xtoviewangle
    let midpic = tex_pics[midtex]
    let toppic = tex_pics[toptex]
    let botpic = tex_pics[bottomtex]
    let mid_cols = midpic.cols
    let mid_wm = midpic.widthmask
    let mid_hm = midpic.heightmask
    let top_cols = toppic.cols
    let top_wm = toppic.widthmask
    let top_hm = toppic.heightmask
    let bot_cols = botpic.cols
    let bot_wm = botpic.widthmask
    let bot_hm = botpic.heightmask
    let dist = w_distance
    let dist_hi = dist >> 16
    let dist_lo = dist & 0xFFFF
    let offset = w_offset
    let centerangle = w_centerangle
    let lightrow = w_lightrow
    let scalestep = w_scalestep
    let topstep = w_topstep
    let bottomstep = w_bottomstep
    let pixhighstep = w_pixhighstep
    let pixlowstep = w_pixlowstep
    let mut scale = w_scale1
    let mut topfrac = w_topfrac
    let mut bottomfrac = w_bottomfrac
    let mut pixhigh = w_pixhigh
    let mut pixlow = w_pixlow
    let midtexmid = w_midtexmid
    let toptexmid = w_toptexmid
    let bottomtexmid = w_bottomtexmid
    for x in start..stopx {
        let cc = ceilingclip[x]
        let fc = floorclip[x]
        let mut yl = (topfrac + 4095) >> 12
        if yl <= cc { yl = cc + 1 }
        if markceiling {
            let mut bottom = yl - 1
            if bottom >= fc { bottom = fc - 1 }
            if cc < bottom {
                pl_top[cbase + x] = cc + 1
                pl_bottom[cbase + x] = bottom
            }
        }
        let mut yh = bottomfrac >> 12
        if yh >= fc { yh = fc - 1 }
        if markfloor {
            let mut top = yh + 1
            if top <= cc { top = cc + 1 }
            if top < fc {
                pl_top[fbase + x] = top
                pl_bottom[fbase + x] = fc - 1
            }
        }
        let mut texcol = 0
        let mut level = 0
        let mut iscale = 0
        if segtextured {
            let t = ftan[((centerangle + xtov[x]) >> 19) & 4095]
            let tl = t & 0xFFFF
            texcol = (offset - ((t >> 16) * dist + tl * dist_hi + ((tl * dist_lo) >> 16))) >> 16
            let mut index = scale >> 12
            if index >= 48 { index = 47 }
            level = scalelight[lightrow + index]
            iscale = 0xFFFFFFFF / scale
        }
        let cmrow = cmap_rows[level]
        if midtex != 0 {
            if yl <= yh {
                if mid_hm >= 0 {
                    let col = mid_cols[texcol & mid_wm]
                    let mut frac = midtexmid + (yl - 100) * iscale
                    for d in (yl * 320 + x)..=(yh * 320 + x) step 320 {
                        out[d] = cmrow[col[(frac >> sh) & mid_hm]]
                        frac += iscale
                    }
                } else {
                    draw_column(out, cmrow, mid_cols[texcol & mid_wm], x, yl, yh, midtexmid, iscale, mid_hm, midpic.height)
                }
            }
            ceilingclip[x] = 200
            floorclip[x] = -1
        } else {
            if toptex != 0 {
                let mut mid = pixhigh >> 12
                pixhigh += pixhighstep
                if mid >= fc { mid = fc - 1 }
                if mid >= yl {
                    if top_hm >= 0 {
                        let col = top_cols[texcol & top_wm]
                        let mut frac = toptexmid + (yl - 100) * iscale
                        for d in (yl * 320 + x)..=(mid * 320 + x) step 320 {
                            out[d] = cmrow[col[(frac >> sh) & top_hm]]
                            frac += iscale
                        }
                    } else {
                        draw_column(out, cmrow, top_cols[texcol & top_wm], x, yl, mid, toptexmid, iscale, top_hm, toppic.height)
                    }
                    ceilingclip[x] = mid
                } else {
                    ceilingclip[x] = yl - 1
                }
            } else {
                if markceiling { ceilingclip[x] = yl - 1 }
            }
            if bottomtex != 0 {
                let mut mid = (pixlow + 4095) >> 12
                pixlow += pixlowstep
                if mid <= cc { mid = cc + 1 }
                if mid <= yh {
                    if bot_hm >= 0 {
                        let col = bot_cols[texcol & bot_wm]
                        let mut frac = bottomtexmid + (mid - 100) * iscale
                        for d in (mid * 320 + x)..=(yh * 320 + x) step 320 {
                            out[d] = cmrow[col[(frac >> sh) & bot_hm]]
                            frac += iscale
                        }
                    } else {
                        draw_column(out, cmrow, bot_cols[texcol & bot_wm], x, mid, yh, bottomtexmid, iscale, bot_hm, botpic.height)
                    }
                    floorclip[x] = mid
                } else {
                    floorclip[x] = yh + 1
                }
            } else {
                if markfloor { floorclip[x] = yh + 1 }
            }
            if masked { openings[masked_base + x] = texcol }
        }
        scale += scalestep
        topfrac += topstep
        bottomfrac += bottomstep
    }
}

fn wall_finish(start: int, stop: int) {
    let stopx = stop + 1
    if ((w_sil & 2) != 0 or w_masked) and w_topclip == -1000000 {
        for x in start..stopx { openings[lastopening + x - start] = ceilingclip[x] }
        w_topclip = lastopening - start
        lastopening += stopx - start
    }
    if ((w_sil & 1) != 0 or w_masked) and w_botclip == -1000000 {
        for x in start..stopx { openings[lastopening + x - start] = floorclip[x] }
        w_botclip = lastopening - start
        lastopening += stopx - start
    }
    if w_masked and (w_sil & 2) == 0 {
        w_sil = w_sil | 2
        w_tsil = -2147483648
    }
    if w_masked and (w_sil & 1) == 0 {
        w_sil = w_sil | 1
        w_bsil = 2147483647
    }
    let d = num_ds
    num_ds++
    ds_x1[d] = start
    ds_x2[d] = stop
    ds_scale1[d] = w_scale1
    ds_scale2[d] = w_scale2
    ds_scalestep[d] = w_scalestep
    ds_sil[d] = w_sil
    ds_bsil[d] = w_bsil
    ds_tsil[d] = w_tsil
    ds_topclip[d] = w_topclip
    ds_botclip[d] = w_botclip
    ds_masked[d] = w_masked_base
    ds_seg[d] = cur_seg
}

fn clip_solid(first: int, last: int) {
    let mut start = 0
    while ss_last[start] < first - 1 { start++ }
    if first < ss_first[start] {
        if last < ss_first[start] - 1 {
            store_wall_range(first, last)
            let mut next = ss_end
            ss_end++
            while next != start {
                ss_first[next] = ss_first[next - 1]
                ss_last[next] = ss_last[next - 1]
                next--
            }
            ss_first[next] = first
            ss_last[next] = last
            return
        }
        store_wall_range(first, ss_first[start] - 1)
        ss_first[start] = first
    }
    if last <= ss_last[start] { return () }
    let mut next = start
    let mut crunch = false
    while last >= ss_first[next + 1] - 1 {
        store_wall_range(ss_last[next] + 1, ss_first[next + 1] - 1)
        next++
        if last <= ss_last[next] {
            ss_last[start] = ss_last[next]
            crunch = true
            break
        }
    }
    if not crunch {
        store_wall_range(ss_last[next] + 1, last)
        ss_last[start] = last
    }
    if next == start { return () }
    while true {
        let old = next
        next++
        if old == ss_end { break }
        start++
        ss_first[start] = ss_first[next]
        ss_last[start] = ss_last[next]
    }
    ss_end = start + 1
    ()
}

fn clip_pass(first: int, last: int) {
    let mut start = 0
    while ss_last[start] < first - 1 { start++ }
    if first < ss_first[start] {
        if last < ss_first[start] - 1 {
            store_wall_range(first, last)
            return
        }
        store_wall_range(first, ss_first[start] - 1)
    }
    if last <= ss_last[start] { return () }
    while last >= ss_first[start + 1] - 1 {
        store_wall_range(ss_last[start] + 1, ss_first[start + 1] - 1)
        start++
        if last <= ss_last[start] { return () }
    }
    store_wall_range(ss_last[start] + 1, last)
}

fn add_line(si: int) {
    let seg = segs[si]
    let mut angle1 = point_to_angle(seg.x1, seg.y1)
    let mut angle2 = point_to_angle(seg.x2, seg.y2)
    let span = (angle1 - angle2) & 0xFFFFFFFF
    if span >= 0x80000000 { return () }
    rw_angle1 = angle1
    angle1 = (angle1 - viewangle) & 0xFFFFFFFF
    angle2 = (angle2 - viewangle) & 0xFFFFFFFF
    let clip = fixed::clipangle
    let mut tspan = (angle1 + clip) & 0xFFFFFFFF
    if tspan > 2 * clip {
        tspan -= 2 * clip
        if tspan >= span { return () }
        angle1 = clip
    }
    tspan = (clip - angle2) & 0xFFFFFFFF
    if tspan > 2 * clip {
        tspan -= 2 * clip
        if tspan >= span { return () }
        angle2 = (0x100000000 - clip) & 0xFFFFFFFF
    }
    let vatx = fixed::viewangletox
    let x1 = vatx[((angle1 + 0x40000000) & 0xFFFFFFFF) >> 19]
    let x2 = vatx[((angle2 + 0x40000000) & 0xFFFFFFFF) >> 19]
    if x1 == x2 { return () }
    cur_seg = si
    cur_back = seg.back
    if cur_back < 0 {
        clip_solid(x1, x2 - 1)
        return
    }
    let front = rooms[cur_front]
    let back = rooms[cur_back]
    if back.ceil <= front.floor or back.floor >= front.ceil {
        clip_solid(x1, x2 - 1)
        return
    }
    if back.ceil != front.ceil or back.floor != front.floor {
        clip_pass(x1, x2 - 1)
        return
    }
    if back.ceilpic == front.ceilpic and back.floorpic == front.floorpic and back.light == front.light and sides[seg.side].mid == 0 {
        return
    }
    clip_pass(x1, x2 - 1)
}

fn check_bbox(bbox: [int; 4]) -> bool {
    let top = bbox[0] << 16
    let bottom = bbox[1] << 16
    let left = bbox[2] << 16
    let right = bbox[3] << 16
    let mut boxx = 2
    if viewx <= left {
        boxx = 0
    } else {
        if viewx < right { boxx = 1 }
    }
    let mut boxy = 2
    if viewy >= top {
        boxy = 0
    } else {
        if viewy > bottom { boxy = 1 }
    }
    let boxpos = boxy * 4 + boxx
    if boxpos == 5 { return true }
    let cc = boxpos * 4
    let x1 = bbox[checkcoord[cc]] << 16
    let y1 = bbox[checkcoord[cc + 1]] << 16
    let x2 = bbox[checkcoord[cc + 2]] << 16
    let y2 = bbox[checkcoord[cc + 3]] << 16
    let mut angle1 = (point_to_angle(x1, y1) - viewangle) & 0xFFFFFFFF
    let mut angle2 = (point_to_angle(x2, y2) - viewangle) & 0xFFFFFFFF
    let span = (angle1 - angle2) & 0xFFFFFFFF
    if span >= 0x80000000 { return true }
    let clip = fixed::clipangle
    let mut tspan = (angle1 + clip) & 0xFFFFFFFF
    if tspan > 2 * clip {
        tspan -= 2 * clip
        if tspan >= span { return false }
        angle1 = clip
    }
    tspan = (clip - angle2) & 0xFFFFFFFF
    if tspan > 2 * clip {
        tspan -= 2 * clip
        if tspan >= span { return false }
        angle2 = (0x100000000 - clip) & 0xFFFFFFFF
    }
    let vatx = fixed::viewangletox
    let sx1 = vatx[((angle1 + 0x40000000) & 0xFFFFFFFF) >> 19]
    let mut sx2 = vatx[((angle2 + 0x40000000) & 0xFFFFFFFF) >> 19]
    if sx1 == sx2 { return false }
    sx2--
    let mut start = 0
    while ss_last[start] < sx2 { start++ }
    if sx1 >= ss_first[start] and sx2 <= ss_last[start] { return false }
    true
}

fn project_sprite(a: Actor, lightrow: int) {
    if num_vs >= 128 { return () }
    let tr_x = a.x - viewx
    let tr_y = a.y - viewy
    let gxt = fmul(tr_x, viewcos)
    let gyt = -fmul(tr_y, viewsin)
    let tz = gxt - gyt
    if tz < 262144 { return () }
    let xscale = fdiv(10485760, tz)
    let gxt2 = -fmul(tr_x, viewsin)
    let gyt2 = fmul(tr_y, viewcos)
    let mut tx = -(gyt2 + gxt2)
    if iabs(tx) > (tz << 2) { return () }
    let def = sprite_defs[a.def]
    let mut rot = 0
    if def.rotate {
        let an = point_to_angle(a.x, a.y)
        rot = (((an - a.angle + 0x90000000) & 0xFFFFFFFF) >> 29)
    }
    let pi = def.pics[rot]
    let flip = def.flips[rot] != 0
    let pic = sprite_pics[pi]
    tx -= pic.left << 16
    let x1 = (10485760 + fmul(tx, xscale)) >> 16
    if x1 > 320 { return () }
    tx += pic.width << 16
    let x2 = ((10485760 + fmul(tx, xscale)) >> 16) - 1
    if x2 < 0 { return () }
    let v = num_vs
    num_vs++
    vs_scale[v] = xscale
    vs_gx[v] = a.x
    vs_gy[v] = a.y
    vs_gz[v] = a.z
    vs_gzt[v] = a.z + (pic.top << 16)
    vs_texturemid[v] = a.z + (pic.top << 16) - viewz
    let vx1 = if x1 < 0 { 0 } else { x1 }
    vs_x1[v] = vx1
    vs_x2[v] = if x2 >= 320 { 319 } else { x2 }
    let iscale = fdiv(65536, xscale)
    let mut startfrac = 0
    let mut xiscale = iscale
    if flip {
        startfrac = (pic.width << 16) - 1
        xiscale = -iscale
    }
    if vx1 > x1 { startfrac += xiscale * (vx1 - x1) }
    vs_startfrac[v] = startfrac
    vs_xiscale[v] = xiscale
    vs_pic[v] = pi
    if a.bright {
        vs_cm[v] = 0
    } else {
        let mut index = xscale >> 12
        if index >= 48 { index = 47 }
        vs_cm[v] = scalelight[lightrow + index]
    }
}

fn add_sprites(sector: int) {
    if sector_stamp[sector] == frame_no { return () }
    sector_stamp[sector] = frame_no
    let mut lightnum = rooms[sector].light >> 4
    if lightnum < 0 { lightnum = 0 }
    if lightnum > 15 { lightnum = 15 }
    for ai in sector_actors[sector] {
        project_sprite(actors[ai], lightnum * 48)
    }
}

fn render_subsector(num: int) {
    let sector = sub_sector[num]
    cur_front = sector
    let room = rooms[sector]
    if room.floor < viewz {
        floorplane = find_plane(room.floor, room.floorpic, room.light)
    } else {
        floorplane = -1
    }
    if room.ceil > viewz or room.ceilpic == sky_flat {
        ceilingplane = find_plane(room.ceil, room.ceilpic, room.light)
    } else {
        ceilingplane = -1
    }
    add_sprites(sector)
    let first = sub_first[num]
    for i in first..(first + sub_count[num]) {
        add_line(i)
    }
}

fn render_child(c: Child) {
    match c {
        Child::Node(i) => render_node(i),
        Child::Leaf(i) => render_subsector(i),
    }
}

fn render_node(n: int) {
    let node = nodes[n]
    if node_side(viewx, viewy, node) == 0 {
        render_child(node.right)
        if check_bbox(node.bbox_left) { render_child(node.left) }
    } else {
        render_child(node.left)
        if check_bbox(node.bbox_right) { render_child(node.right) }
    }
}

fn map_plane(mut out: Vec<int>, flat: Vec<int>, y: int, x1: int, x2: int, s10: int, s16: int, m63: int, m4032: int) {
    let mut distance = 0
    let mut xstep = 0
    let mut ystep = 0
    if plane_height != cachedheight[y] {
        cachedheight[y] = plane_height
        distance = fmul(plane_height, yslope[y])
        cacheddistance[y] = distance
        xstep = fmul(distance, basexscale)
        cachedxstep[y] = xstep
        ystep = fmul(distance, baseyscale)
        cachedystep[y] = ystep
    } else {
        distance = cacheddistance[y]
        xstep = cachedxstep[y]
        ystep = cachedystep[y]
    }
    let ds = distscale[x1]
    let dl = distance & 0xFFFF
    let length = (distance >> 16) * ds + dl * (ds >> 16) + ((dl * (ds & 0xFFFF)) >> 16)
    let angle = ((viewangle + fixed::xtoviewangle[x1]) & 0xFFFFFFFF) >> 19
    let c = fixed::finesine[angle + 2048]
    let sn = fixed::finesine[angle]
    let ll = length & 0xFFFF
    let lh = length >> 16
    let cl = c & 0xFFFF
    let sl = sn & 0xFFFF
    let xfrac = viewx + (c >> 16) * length + cl * lh + ((cl * ll) >> 16)
    let yfrac = -viewy - ((sn >> 16) * length + sl * lh + ((sl * ll) >> 16))
    let mut index = distance >> 20
    if index >= 128 { index = 127 }
    let cmrow = cmap_rows[zlight[plane_zrow + index]]
    let mut xf = xfrac
    let mut yf = yfrac
    let row = y * 320
    for d in (row + x1)..=(row + x2) {
        out[d] = cmrow[flat[((yf >> s10) & m4032) + ((xf >> s16) & m63)]]
        xf += xstep
        yf += ystep
    }
}

fn draw_planes() {
    for p in 0..num_planes {
        let minx = pl_minx[p]
        let maxx = pl_maxx[p]
        if minx > maxx { continue }
        let base = p * 322 + 1
        if pl_pic[p] == sky_flat {
            let sky = tex_pics[sky_tex]
            let sky_row = cmap_rows[0]
            let xtov = fixed::xtoviewangle
            for x in minx..=maxx {
                let yl = pl_top[base + x]
                let yh = pl_bottom[base + x]
                if yl <= yh {
                    let angle = ((viewangle + xtov[x]) & 0xFFFFFFFF) >> 22
                    draw_column(fb, sky_row, sky.cols[angle & sky.widthmask], x, yl, yh, 6553600, 65536, sky.heightmask, sky.height)
                }
            }
            continue
        }
        if pl_pic[p] < 0 { continue }
        plane_flat = flat_pix[pl_pic[p]]
        plane_height = pl_height[p] - viewz
        if plane_height < 0 { plane_height = -plane_height }
        let mut light = pl_light[p] >> 4
        if light < 0 { light = 0 }
        if light > 15 { light = 15 }
        plane_zrow = light * 128
        pl_top[base + maxx + 1] = 255
        pl_top[base + minx - 1] = 255
        let mut prev_t = 255
        let mut prev_b = 0
        for x in minx..=(maxx + 1) {
            let mut t1 = prev_t
            let mut b1 = prev_b
            let mut t2 = pl_top[base + x]
            let mut b2 = pl_bottom[base + x]
            prev_t = t2
            prev_b = b2
            if t1 == t2 and b1 == b2 { continue }
            while t1 < t2 and t1 <= b1 {
                map_plane(fb, plane_flat, t1, spanstart[t1], x - 1, 10, 16, 63, 4032)
                t1++
            }
            while b1 > b2 and b1 >= t1 {
                map_plane(fb, plane_flat, b1, spanstart[b1], x - 1, 10, 16, 63, 4032)
                b1--
            }
            while t2 < t1 and t2 <= b2 {
                spanstart[t2] = x
                t2++
            }
            while b2 > b1 and b2 >= t2 {
                spanstart[b2] = x
                b2--
            }
        }
    }
    for p in 0..num_planes {
        let base = p * 322 + 1
        if pl_minx[p] <= pl_maxx[p] {
            for i in (base + pl_minx[p])..=(base + pl_maxx[p]) { pl_top[i] = 255 }
        }
    }
}

fn seg_side(x: int, y: int, seg: WallSeg) -> int {
    let lx = seg.x1
    let ly = seg.y1
    let ldx = seg.x2 - lx
    let ldy = seg.y2 - ly
    if ldx == 0 {
        if x <= lx { return if ldy > 0 { 1 } else { 0 } }
        return if ldy < 0 { 1 } else { 0 }
    }
    if ldy == 0 {
        if y <= ly { return if ldx < 0 { 1 } else { 0 } }
        return if ldx > 0 { 1 } else { 0 }
    }
    let dx = x - lx
    let dy = y - ly
    if (ldy ^ ldx ^ dx ^ dy) < 0 {
        if (ldy ^ dx) < 0 { return 1 }
        return 0
    }
    let left = ((ldy >> 16) * dx) >> 16
    let right = (dy * (ldx >> 16)) >> 16
    if right < left { 0 } else { 1 }
}

fn render_masked_seg(d: int, x1: int, x2: int) {
    let seg = segs[ds_seg[d]]
    let side = sides[seg.side]
    let front = rooms[seg.front]
    let back = rooms[seg.back]
    let pic = tex_pics[side.mid]
    let mut lightnum = front.light >> 4
    if seg.y1 == seg.y2 {
        lightnum--
    } else {
        if seg.x1 == seg.x2 { lightnum++ }
    }
    if lightnum < 0 { lightnum = 0 }
    if lightnum > 15 { lightnum = 15 }
    let lightrow = lightnum * 48
    let mbase = ds_masked[d]
    let tbase = ds_topclip[d]
    let bbase = ds_botclip[d]
    let sstep = ds_scalestep[d]
    let mut yscale = ds_scale1[d] + (x1 - ds_x1[d]) * sstep
    let mut texmid = 0
    if (seg.flags & 16) != 0 {
        texmid = front.floor
        if back.floor > texmid { texmid = back.floor }
        texmid = texmid + tex_heights[side.mid] - viewz
    } else {
        texmid = front.ceil
        if back.ceil < texmid { texmid = back.ceil }
        texmid = texmid - viewz
    }
    texmid += side.yoff
    for x in x1..=x2 {
        let col = openings[mbase + x]
        if col != 32767 {
            let mut index = yscale >> 12
            if index >= 48 { index = 47 }
            let cmrow = cmap_rows[scalelight[lightrow + index]]
            let topscreen = 6553600 - fmul(texmid, yscale)
            let iscale = 0xFFFFFFFF / yscale
            draw_masked_column(pic, col & pic.widthmask, x, topscreen, yscale, texmid, iscale, cmrow, openings[tbase + x], openings[bbase + x])
            openings[mbase + x] = 32767
        }
        yscale += sstep
    }
}

fn draw_sprite(v: int) {
    let sx1 = vs_x1[v]
    let sx2 = vs_x2[v]
    for x in sx1..=sx2 {
        clipbot[x] = -2
        cliptop[x] = -2
    }
    let mut d = num_ds - 1
    while d >= 0 {
        let dx1 = ds_x1[d]
        let dx2 = ds_x2[d]
        if dx1 > sx2 or dx2 < sx1 or (ds_sil[d] == 0 and ds_masked[d] == -1000000) {
            d--
            continue
        }
        let r1 = if dx1 < sx1 { sx1 } else { dx1 }
        let r2 = if dx2 > sx2 { sx2 } else { dx2 }
        let mut lowscale = ds_scale1[d]
        let mut scale = ds_scale2[d]
        if ds_scale1[d] > ds_scale2[d] {
            lowscale = ds_scale2[d]
            scale = ds_scale1[d]
        }
        if scale < vs_scale[v] or (lowscale < vs_scale[v] and seg_side(vs_gx[v], vs_gy[v], segs[ds_seg[d]]) == 0) {
            if ds_masked[d] != -1000000 { render_masked_seg(d, r1, r2) }
            d--
            continue
        }
        let mut sil = ds_sil[d]
        if vs_gz[v] >= ds_bsil[d] { sil = sil & 2 }
        if vs_gzt[v] <= ds_tsil[d] { sil = sil & 1 }
        if (sil & 1) != 0 {
            let b = ds_botclip[d]
            for x in r1..=r2 {
                if clipbot[x] == -2 { clipbot[x] = openings[b + x] }
            }
        }
        if (sil & 2) != 0 {
            let t = ds_topclip[d]
            for x in r1..=r2 {
                if cliptop[x] == -2 { cliptop[x] = openings[t + x] }
            }
        }
        d--
    }
    for x in sx1..=sx2 {
        if clipbot[x] == -2 { clipbot[x] = 200 }
        if cliptop[x] == -2 { cliptop[x] = -1 }
    }
    let pic = sprite_pics[vs_pic[v]]
    let yscale = vs_scale[v]
    let texmid = vs_texturemid[v]
    let topscreen = 6553600 - fmul(texmid, yscale)
    let xiscale = vs_xiscale[v]
    let iscale = iabs(xiscale)
    let cmrow = cmap_rows[vs_cm[v]]
    let mut frac = vs_startfrac[v]
    for x in sx1..=sx2 {
        let col = frac >> 16
        if col >= 0 and col < pic.width {
            draw_masked_column(pic, col, x, topscreen, yscale, texmid, iscale, cmrow, cliptop[x], clipbot[x])
        }
        frac += xiscale
    }
}

fn draw_masked() {
    for i in 0..num_vs { vs_order[i] = i }
    for i in 1..num_vs {
        let cur = vs_order[i]
        let s = vs_scale[cur]
        let mut j = i - 1
        while j >= 0 and vs_scale[vs_order[j]] > s {
            vs_order[j + 1] = vs_order[j]
            j--
        }
        vs_order[j + 1] = cur
    }
    for i in 0..num_vs { draw_sprite(vs_order[i]) }
    let mut d = num_ds - 1
    while d >= 0 {
        if ds_masked[d] != -1000000 { render_masked_seg(d, ds_x1[d], ds_x2[d]) }
        d--
    }
}

fn clear_frame() {
    ss_first[0] = -2147483647
    ss_last[0] = -1
    ss_first[1] = 320
    ss_last[1] = 2147483647
    ss_end = 2
    for x in 0..320 {
        ceilingclip[x] = -1
        floorclip[x] = 200
    }
    for y in 0..200 { cachedheight[y] = 0 }
    num_planes = 0
    num_ds = 0
    num_vs = 0
    lastopening = 640
    frame_no++
    let angle = ((viewangle - 0x40000000) & 0xFFFFFFFF) >> 19
    basexscale = fdiv(fixed::finesine[angle + 2048], 10485760)
    baseyscale = -fdiv(fixed::finesine[angle], 10485760)
}

pub fn render_frame(view_x: int, view_y: int, view_z: int, angle: int) {
    viewx = view_x
    viewy = view_y
    viewz = view_z
    viewangle = angle & 0xFFFFFFFF
    let fi = viewangle >> 19
    viewsin = fixed::finesine[fi]
    viewcos = fixed::finesine[fi + 2048]
    let t0 = time::timer()
    clear_frame()
    render_node(num_nodes - 1)
    let t1 = time::elapsed(t0)
    draw_planes()
    let t2 = time::elapsed(t0)
    draw_masked()
    let t3 = time::elapsed(t0)
    time_bsp += t1 * 1000.0
    time_planes += (t2 - t1) * 1000.0
    time_masked += (t3 - t2) * 1000.0
}

pub fn reset_times() {
    time_bsp = 0.0
    time_planes = 0.0
    time_masked = 0.0
}

pub fn time_bsp_ms() -> float { time_bsp }
pub fn time_planes_ms() -> float { time_planes }
pub fn time_masked_ms() -> float { time_masked }

pub fn frame_stats() -> string {
    "planes {num_planes} drawsegs {num_ds} sprites {num_vs} openings {lastopening}"
}

pub fn palette_rgb(g: Graphics) -> Vec<int> {
    let mut pal: Vec<int> = vec![0; 256]
    for i in 0..256 {
        pal[i] = (g.playpal[3 * i] << 16) | (g.playpal[3 * i + 1] << 8) | g.playpal[3 * i + 2]
    }
    pal
}

pub fn to_rgb(pal: Vec<int>, mut out: Vec<int>) {
    let src = fb
    for i in 0..64000 { out[i] = pal[src[i]] }
}
