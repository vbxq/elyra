fn p_abs(a: int) -> int {
    if a < 0 { -a } else { a }
}

fn p_push_int(mut v: Vec<int>, x: int) { v.push(x) }

fn p_node_side(x: int, y: int, node: Node) -> int {
    let nx = node.x << 16
    let ny = node.y << 16
    let ndx = node.dx
    let ndy = node.dy
    if ndx == 0 {
        if x <= nx { return if ndy > 0 { 1 } else { 0 } }
        return if ndy < 0 { 1 } else { 0 }
    }
    if ndy == 0 {
        if y <= ny { return if ndx < 0 { 1 } else { 0 } }
        return if ndx > 0 { 1 } else { 0 }
    }
    let dx = x - nx
    let dy = y - ny
    if (ndy ^ ndx ^ dx ^ dy) < 0 {
        if (ndy ^ dx) < 0 { return 1 }
        return 0
    }
    let left = (ndy * dx) >> 16
    let right = (dy * ndx) >> 16
    if right < left { 0 } else { 1 }
}

fn p_subsector_at(x: int, y: int) -> int {
    let mut n = p_num_nodes - 1
    while true {
        let node = p_nodes[n]
        let c: Child = if p_node_side(x, y, node) == 0 { node.right } else { node.left }
        match c {
            Child::Leaf(i) => { return i },
            Child::Node(i) => { n = i },
        }
    }
    0
}

pub fn sector_at(x: int, y: int) -> int {
    ss_sector[p_subsector_at(x, y)]
}

pub fn angle_to(x: int, y: int) -> int {
    let mut base = 0
    let mut neg = false
    let mut num = y
    let mut den = x
    let mut ax = x
    let mut ay = y
    if x == 0 and y == 0 { return 0 }
    if ax >= 0 {
        if ay >= 0 {
            if ax <= ay {
                base = 0x3FFFFFFF
                neg = true
                num = ax
                den = ay
            }
        } else {
            ay = -ay
            num = ay
            if ax > ay {
                base = 0x100000000
                neg = true
            } else {
                base = 0xC0000000
                num = ax
                den = ay
            }
        }
    } else {
        ax = -ax
        den = ax
        if ay >= 0 {
            if ax > ay {
                base = 0x7FFFFFFF
                neg = true
            } else {
                base = 0x40000000
                num = ax
                den = ay
            }
        } else {
            ay = -ay
            num = ay
            if ax > ay {
                base = 0x80000000
            } else {
                base = 0xBFFFFFFF
                neg = true
                num = ax
                den = ay
            }
        }
    }
    let mut slope = 2048
    if den >= 512 {
        slope = (num << 3) / (den >> 8)
        if slope > 2048 { slope = 2048 }
    }
    if neg { (base - fixed::tantoangle[slope]) & 0xFFFFFFFF } else { (base + fixed::tantoangle[slope]) & 0xFFFFFFFF }
}

fn p_is_monster(kind: int) -> bool {
    kind == 3004 or kind == 9 or kind == 3001 or kind == 3002 or kind == 58 or kind == 3006 or kind == 3005 or kind == 3003 or kind == 16 or kind == 7
}

fn solid_radius(kind: int) -> int {
    match kind {
        3004 => 20,
        9 => 20,
        3001 => 20,
        3002 => 30,
        58 => 30,
        3006 => 16,
        3005 => 31,
        3003 => 24,
        2035 => 10,
        2028 => 16,
        30 => 16,
        31 => 16,
        32 => 16,
        33 => 16,
        35 => 16,
        36 => 16,
        37 => 16,
        41 => 16,
        42 => 16,
        43 => 16,
        44 => 16,
        45 => 16,
        46 => 16,
        47 => 16,
        48 => 16,
        54 => 32,
        55 => 16,
        56 => 16,
        57 => 16,
        25 => 16,
        26 => 16,
        27 => 16,
        28 => 16,
        29 => 16,
        49 => 16,
        50 => 16,
        51 => 16,
        52 => 16,
        53 => 16,
        70 => 16,
        _ => 0,
    }
}

fn setup_lines(lv: Level) {
    let n = lv.linedefs.len()
    num_lines = n
    l_x1 = vec![0; n]
    l_y1 = vec![0; n]
    l_dx = vec![0; n]
    l_dy = vec![0; n]
    l_left = vec![0; n]
    l_right = vec![0; n]
    l_bottom = vec![0; n]
    l_top = vec![0; n]
    l_slope = vec![0; n]
    l_flags = vec![0; n]
    l_special = vec![0; n]
    l_tag = vec![0; n]
    l_front = vec![0; n]
    l_back = vec![0; n]
    l_valid = vec![0; n]
    for i in 0..n {
        let ld = lv.linedefs[i]
        let v1 = lv.vertexes[ld.v1]
        let v2 = lv.vertexes[ld.v2]
        let x1 = v1.x << 16
        let y1 = v1.y << 16
        let x2 = v2.x << 16
        let y2 = v2.y << 16
        let dx = x2 - x1
        let dy = y2 - y1
        l_x1[i] = x1
        l_y1[i] = y1
        l_dx[i] = dx
        l_dy[i] = dy
        let mut slope = 3
        if dx == 0 {
            slope = 1
        } else {
            if dy == 0 {
                slope = 0
            } else {
                if (dx > 0) == (dy > 0) { slope = 2 }
            }
        }
        l_slope[i] = slope
        if x1 < x2 { l_left[i] = x1; l_right[i] = x2 } else { l_left[i] = x2; l_right[i] = x1 }
        if y1 < y2 { l_bottom[i] = y1; l_top[i] = y2 } else { l_bottom[i] = y2; l_top[i] = y1 }
        l_flags[i] = ld.flags
        l_special[i] = ld.special
        l_tag[i] = ld.tag
        l_front[i] = lv.sidedefs[ld.front].sector
        l_back[i] = -1
        if ld.back >= 0 { l_back[i] = lv.sidedefs[ld.back].sector }
    }
}

fn setup_sectors(lv: Level) {
    let n = lv.sectors.len()
    s_floor = vec![0; n]
    s_ceil = vec![0; n]
    s_left = vec![2147483647; n]
    s_right = vec![-2147483647; n]
    s_bottom = vec![2147483647; n]
    s_top = vec![-2147483647; n]
    s_door = vec![-1; n]
    s_tag = vec![0; n]
    s_lift = vec![-1; n]
    num_sectors = n
    for i in 0..n {
        let s = lv.sectors[i]
        s_floor[i] = s.floor_h << 16
        s_ceil[i] = s.ceil_h << 16
        s_tag[i] = s.tag
    }
    for i in 0..num_lines {
        grow_sector_box(l_front[i], i)
        if l_back[i] >= 0 { grow_sector_box(l_back[i], i) }
    }
}

fn grow_sector_box(s: int, l: int) {
    if l_left[l] < s_left[s] { s_left[s] = l_left[l] }
    if l_right[l] > s_right[s] { s_right[s] = l_right[l] }
    if l_bottom[l] < s_bottom[s] { s_bottom[s] = l_bottom[l] }
    if l_top[l] > s_top[s] { s_top[s] = l_top[l] }
}

fn setup_things(lv: Level) {
    th_x = vec![]
    th_y = vec![]
    th_r = vec![]
    th_blocks = vec![]
    for b in 0..(bm_w * bm_h) {
        let fresh: Vec<int> = vec![]
        th_blocks.push(fresh)
    }
    for t in lv.things {
        if t.kind == 1 {
            px = t.x << 16
            py = t.y << 16
            pangle = (0x20000000 * (t.angle / 45)) & 0xFFFFFFFF
        }
        if (t.flags & 16) != 0 { continue }
        if (t.flags & p_skill_bit) == 0 { continue }
        if p_no_monsters and p_is_monster(t.kind) { continue }
        let r = solid_radius(t.kind)
        if r == 0 { continue }
        let x = t.x << 16
        let y = t.y << 16
        let bx = (x - bm_ox) >> 23
        let by = (y - bm_oy) >> 23
        if bx < 0 or by < 0 or bx >= bm_w or by >= bm_h { continue }
        th_x.push(x)
        th_y.push(y)
        th_r.push(r << 16)
        p_push_int(th_blocks[by * bm_w + bx], th_x.len() - 1)
    }
    num_solid = th_x.len()
}

pub fn init_level(mut lv: Level, skill_bit: int, no_monsters: bool) {
    p_skill_bit = skill_bit
    p_no_monsters = no_monsters
    setup_lines(lv)
    setup_sectors(lv)
    let bm = lv.blockmap
    bm_ox = bm.origin_x << 16
    bm_oy = bm.origin_y << 16
    bm_w = bm.columns
    bm_h = bm.rows
    bm_lists = lv.blockmap.lists
    p_nodes = lv.nodes
    p_num_nodes = p_nodes.len()
    ss_sector = vec![]
    for ss in lv.subsectors {
        let seg = lv.segs[ss.first_seg]
        let ld = lv.linedefs[seg.linedef]
        let side = if seg.direction == 0 { ld.front } else { ld.back }
        ss_sector.push(lv.sidedefs[side].sector)
    }
    setup_things(lv)
    let sec = sector_at(px, py)
    pz = s_floor[sec]
    pfloorz = s_floor[sec]
    pceilz = s_ceil[sec]
    if check_position(px, py) {
        pfloorz = tm_floor
        pceilz = tm_ceil
    }
    pviewheight = 2686976
    pdeltaview = 0
    pviewz = pz + pviewheight
    pmomx = 0
    pmomy = 0
    pmomz = 0
    leveltime = 0
    println("play init_level: {num_lines} lines, {s_floor.len()} sectors, {num_solid} solid things, blockmap {bm_w}x{bm_h}, start {px >> 16},{py >> 16}")
}

fn point_on_line_side(x: int, y: int, l: int) -> int {
    let ldx = l_dx[l]
    let ldy = l_dy[l]
    if ldx == 0 {
        if x <= l_x1[l] { return if ldy > 0 { 1 } else { 0 } }
        return if ldy < 0 { 1 } else { 0 }
    }
    if ldy == 0 {
        if y <= l_y1[l] { return if ldx < 0 { 1 } else { 0 } }
        return if ldx > 0 { 1 } else { 0 }
    }
    let dx = x - l_x1[l]
    let dy = y - l_y1[l]
    let left = ((ldy >> 16) * dx) >> 16
    let right = (dy * (ldx >> 16)) >> 16
    if right < left { 0 } else { 1 }
}

fn box_on_line_side(l: int) -> int {
    let slope = l_slope[l]
    let mut p1 = 0
    let mut p2 = 0
    if slope == 0 {
        let y1 = l_y1[l]
        if tm_top > y1 { p1 = 1 }
        if tm_bottom > y1 { p2 = 1 }
        if l_dx[l] < 0 { p1 = 1 - p1; p2 = 1 - p2 }
    } else {
        if slope == 1 {
            let x1 = l_x1[l]
            if tm_right < x1 { p1 = 1 }
            if tm_left < x1 { p2 = 1 }
            if l_dy[l] < 0 { p1 = 1 - p1; p2 = 1 - p2 }
        } else {
            if slope == 2 {
                p1 = point_on_line_side(tm_left, tm_top, l)
                p2 = point_on_line_side(tm_right, tm_bottom, l)
            } else {
                p1 = point_on_line_side(tm_right, tm_top, l)
                p2 = point_on_line_side(tm_left, tm_bottom, l)
            }
        }
    }
    if p1 == p2 { p1 } else { -1 }
}

fn check_line(l: int) -> bool {
    if tm_right <= l_left[l] or tm_left >= l_right[l] or tm_top <= l_bottom[l] or tm_bottom >= l_top[l] { return true }
    if box_on_line_side(l) != -1 { return true }
    let b = l_back[l]
    if b < 0 or (l_flags[l] & 1) != 0 {
        tm_blockline = l
        return false
    }
    let f = l_front[l]
    let mut opentop = s_ceil[f]
    if s_ceil[b] < opentop { opentop = s_ceil[b] }
    let mut openbottom = s_floor[f]
    let mut lowfloor = s_floor[b]
    if s_floor[b] > openbottom {
        openbottom = s_floor[b]
        lowfloor = s_floor[f]
    }
    if opentop < tm_ceil {
        tm_ceil = opentop
        tm_ceilline = l
    }
    if openbottom > tm_floor {
        tm_floor = openbottom
        tm_floorline = l
    }
    if lowfloor < tm_drop { tm_drop = lowfloor }
    if l_special[l] != 0 and num_spec < 16 {
        spec_l[num_spec] = l
        num_spec++
    }
    true
}

fn block_lines(bx: int, by: int) -> bool {
    if bx < 0 or by < 0 or bx >= bm_w or by >= bm_h { return true }
    let vc = validcount
    for l in bm_lists[by * bm_w + bx] {
        if l_valid[l] == vc { continue }
        l_valid[l] = vc
        if not check_line(l) { return false }
    }
    true
}

fn block_things(bx: int, by: int) -> bool {
    if bx < 0 or by < 0 or bx >= bm_w or by >= bm_h { return true }
    for t in th_blocks[by * bm_w + bx] {
        let bd = th_r[t] + 1048576
        if p_abs(th_x[t] - tm_x) < bd and p_abs(th_y[t] - tm_y) < bd {
            tm_blockline = -1
            return false
        }
    }
    true
}

fn check_position(x: int, y: int) -> bool {
    tm_x = x
    tm_y = y
    tm_left = x - 1048576
    tm_right = x + 1048576
    tm_bottom = y - 1048576
    tm_top = y + 1048576
    let sec = ss_sector[p_subsector_at(x, y)]
    tm_floor = s_floor[sec]
    tm_drop = tm_floor
    tm_ceil = s_ceil[sec]
    tm_floorline = -1
    tm_ceilline = -1
    tm_blockline = -2
    num_spec = 0
    validcount++
    let txl = (tm_left - bm_ox - 2097152) >> 23
    let txh = (tm_right - bm_ox + 2097152) >> 23
    let tyl = (tm_bottom - bm_oy - 2097152) >> 23
    let tyh = (tm_top - bm_oy + 2097152) >> 23
    for bx in txl..(txh + 1) {
        for by in tyl..(tyh + 1) {
            if not block_things(bx, by) { return false }
        }
    }
    let xl = (tm_left - bm_ox) >> 23
    let xh = (tm_right - bm_ox) >> 23
    let yl = (tm_bottom - bm_oy) >> 23
    let yh = (tm_top - bm_oy) >> 23
    for bx in xl..(xh + 1) {
        for by in yl..(yh + 1) {
            if not block_lines(bx, by) { return false }
        }
    }
    true
}

fn fit_blockline() -> int {
    if tm_ceilline >= 0 { tm_ceilline } else { tm_floorline }
}

fn try_move(x: int, y: int, commit: bool) -> bool {
    moves_tried++
    if not check_position(x, y) { return false }
    if tm_ceil - tm_floor < 3670016 {
        tm_blockline = fit_blockline()
        return false
    }
    if tm_ceil - pz < 3670016 {
        tm_blockline = tm_ceilline
        return false
    }
    if tm_floor - pz > 1572864 {
        tm_blockline = tm_floorline
        return false
    }
    if commit {
        let ox = px
        let oy = py
        px = x
        py = y
        pfloorz = tm_floor
        pceilz = tm_ceil
        let n = num_spec
        for k in 0..n {
            let l = spec_l[k]
            if point_on_line_side(ox, oy, l) != point_on_line_side(px, py, l) { cross_special(l) }
        }
    }
    true
}

fn slide_move() {
    slides++
    let mx = pmomx
    let my = pmomy
    let mut bl = tm_blockline
    let mut lo = 0
    let mut hi = 32
    for k in 0..5 {
        let mid = (lo + hi) >> 1
        if try_move(px + mx * mid / 32, py + my * mid / 32, false) {
            lo = mid
        } else {
            hi = mid
            bl = tm_blockline
        }
    }
    if lo > 0 {
        let _ = try_move(px + mx * lo / 32, py + my * lo / 32, true)
    }
    if bl >= 0 {
        let ldx = convert::to_float(l_dx[bl] >> 8)
        let ldy = convert::to_float(l_dy[bl] >> 8)
        let rest = convert::to_float(32 - lo) / 32.0
        let d = (convert::to_float(mx) * ldx + convert::to_float(my) * ldy) / (ldx * ldx + ldy * ldy) * rest
        let nx = convert::to_int(ldx * d)
        let ny = convert::to_int(ldy * d)
        pmomx = nx
        pmomy = ny
        if try_move(px + nx, py + ny, true) { return () }
        if try_move(px + nx / 2, py + ny / 2, true) { return () }
    }
    if not try_move(px, py + my, true) {
        let _ = try_move(px + mx, py, true)
    }
    ()
}

fn xy_movement() {
    if pmomx == 0 and pmomy == 0 { return () }
    if pmomx > 1966080 { pmomx = 1966080 }
    if pmomx < -1966080 { pmomx = -1966080 }
    if pmomy > 1966080 { pmomy = 1966080 }
    if pmomy < -1966080 { pmomy = -1966080 }
    let mut xmove = pmomx
    let mut ymove = pmomy
    while xmove != 0 or ymove != 0 {
        let mut tx = 0
        let mut ty = 0
        if p_abs(xmove) > 983040 or p_abs(ymove) > 983040 {
            xmove = xmove / 2
            ymove = ymove / 2
            tx = px + xmove
            ty = py + ymove
        } else {
            tx = px + xmove
            ty = py + ymove
            xmove = 0
            ymove = 0
        }
        if not try_move(tx, ty, true) {
            slide_move()
            xmove = 0
            ymove = 0
        }
    }
    if pz > pfloorz { return () }
    if pmomx > -4096 and pmomx < 4096 and pmomy > -4096 and pmomy < 4096 and cmd_fwd == 0 and cmd_side == 0 {
        pmomx = 0
        pmomy = 0
    } else {
        pmomx = pmomx.mul_shr(59392, 16)
        pmomy = pmomy.mul_shr(59392, 16)
    }
    ()
}

fn z_movement() {
    if pz < pfloorz {
        pviewheight -= pfloorz - pz
        pdeltaview = (2686976 - pviewheight) >> 3
    }
    pz += pmomz
    if pz <= pfloorz {
        if pmomz < 0 {
            if pmomz < -524288 { pdeltaview = pmomz >> 3 }
            pmomz = 0
        }
        pz = pfloorz
    } else {
        if pmomz == 0 { pmomz = -131072 } else { pmomz -= 65536 }
    }
    if pz + 3670016 > pceilz {
        if pmomz > 0 { pmomz = 0 }
        pz = pceilz - 3670016
    }
    ()
}

fn calc_height() {
    let mut bob = (pmomx.mul_shr(pmomx, 16) + pmomy.mul_shr(pmomy, 16)) >> 2
    if bob > 1048576 { bob = 1048576 }
    if pz > pfloorz {
        pviewz = pz + pviewheight
        if pviewz > pceilz - 262144 { pviewz = pceilz - 262144 }
        return ()
    }
    let fa = (409 * leveltime) & 8191
    let b = (bob / 2).mul_shr(fixed::finesine[fa], 16)
    pviewheight += pdeltaview
    if pviewheight > 2686976 {
        pviewheight = 2686976
        pdeltaview = 0
    }
    if pviewheight < 1343488 {
        pviewheight = 1343488
        if pdeltaview <= 0 { pdeltaview = 1 }
    }
    if pdeltaview != 0 {
        pdeltaview += 16384
        if pdeltaview == 0 { pdeltaview = 1 }
    }
    pviewz = pz + pviewheight + b
    if pviewz > pceilz - 262144 { pviewz = pceilz - 262144 }
    ()
}

fn thrust(angle: int, amount: int) {
    let fi = (angle & 0xFFFFFFFF) >> 19
    pmomx += amount.mul_shr(fixed::finesine[fi + 2048], 16)
    pmomy += amount.mul_shr(fixed::finesine[fi], 16)
}

fn lowest_ceiling_around(sec: int) -> int {
    let mut best = 2147483647
    for l in 0..num_lines {
        let b = l_back[l]
        if b < 0 { continue }
        let f = l_front[l]
        let mut other = -1
        if f == sec { other = b }
        if b == sec { other = f }
        if other >= 0 and s_ceil[other] < best { best = s_ceil[other] }
    }
    best
}

fn set_ceiling(s: int, h: int) {
    s_ceil[s] = h
    render::set_sector_ceiling(s, h)
}

fn change_sector(s: int) -> bool {
    if px + 1048576 <= s_left[s] or px - 1048576 >= s_right[s] or py + 1048576 <= s_bottom[s] or py - 1048576 >= s_top[s] { return false }
    if check_position(px, py) {
        let onfloor = pz == pfloorz
        pfloorz = tm_floor
        pceilz = tm_ceil
        if onfloor { pz = pfloorz }
        if pz + 3670016 > pceilz { pz = pceilz - 3670016 }
    }
    pceilz - pfloorz < 3670016
}

fn new_door(sec: int, speed: int, stay: int) {
    let mut d = 0
    while d < 31 and d_live[d] != 0 { d++ }
    d_live[d] = 1
    d_sector[d] = sec
    d_dir[d] = 1
    d_speed[d] = speed
    d_stay[d] = stay
    d_count[d] = 0
    d_topz[d] = lowest_ceiling_around(sec) - 262144
    s_door[sec] = d
    doors_opened++
}

fn vertical_door(l: int, special: int) {
    let sec = l_back[l]
    if sec < 0 { return () }
    let cur = s_door[sec]
    if cur >= 0 {
        if special == 1 or special == 117 {
            if d_dir[cur] == -1 { d_dir[cur] = 1 } else { d_dir[cur] = -1 }
        }
        return ()
    }
    let mut speed = 131072
    if special == 117 { speed = 524288 }
    let mut stay = 0
    if special == 31 {
        stay = 1
        l_special[l] = 0
    }
    new_door(sec, speed, stay)
    ()
}

fn tagged_door_open(tag: int) {
    for s in 0..num_sectors {
        if s_tag[s] == tag and s_door[s] < 0 { new_door(s, 131072, 1) }
    }
}

fn lowest_floor_around(sec: int) -> int {
    let mut best = s_floor[sec]
    for l in 0..num_lines {
        let b = l_back[l]
        if b < 0 { continue }
        let f = l_front[l]
        let mut other = -1
        if f == sec { other = b }
        if b == sec { other = f }
        if other >= 0 and s_floor[other] < best { best = s_floor[other] }
    }
    best
}

fn start_lifts(tag: int) {
    for s in 0..num_sectors {
        if s_tag[s] != tag or s_lift[s] >= 0 { continue }
        let mut p = 0
        while p < 15 and lf_live[p] != 0 { p++ }
        lf_live[p] = 1
        lf_sector[p] = s
        lf_low[p] = lowest_floor_around(s)
        lf_high[p] = s_floor[s]
        lf_status[p] = 1
        lf_count[p] = 0
        s_lift[s] = p
        lifts_started++
    }
}

fn use_special(l: int) {
    let sp = l_special[l]
    if sp == 1 or sp == 31 or sp == 117 { vertical_door(l, sp) }
    if sp == 62 { start_lifts(l_tag[l]) }
}

fn cross_special(l: int) {
    lines_crossed++
    let sp = l_special[l]
    if sp == 2 {
        tagged_door_open(l_tag[l])
        l_special[l] = 0
    }
    if sp == 88 { start_lifts(l_tag[l]) }
}

fn set_floor(s: int, h: int) {
    s_floor[s] = h
    render::set_sector_floor(s, h)
}

fn lift_tick(p: int) {
    let s = lf_sector[p]
    let st = lf_status[p]
    if st == 2 {
        lf_count[p] -= 1
        if lf_count[p] <= 0 {
            if s_floor[s] == lf_low[p] { lf_status[p] = 0 } else { lf_status[p] = 1 }
        }
        return ()
    }
    let old = s_floor[s]
    if st == 1 {
        if old - 262144 < lf_low[p] {
            set_floor(s, lf_low[p])
            let _ = change_sector(s)
            lf_status[p] = 2
            lf_count[p] = 105
        } else {
            set_floor(s, old - 262144)
            let _ = change_sector(s)
        }
        return ()
    }
    let mut dest = old + 262144
    let past = dest > lf_high[p]
    if past { dest = lf_high[p] }
    set_floor(s, dest)
    if change_sector(s) {
        set_floor(s, old)
        let _ = change_sector(s)
        if not past {
            lf_status[p] = 1
            return ()
        }
    }
    if past {
        lf_live[p] = 0
        s_lift[s] = -1
    }
    ()
}

fn seg_cross(l: int, x1: float, y1: float, ddx: float, ddy: float) -> float {
    let ax = convert::to_float(l_x1[l] >> 8) / 256.0
    let ay = convert::to_float(l_y1[l] >> 8) / 256.0
    let ex = convert::to_float(l_dx[l] >> 8) / 256.0
    let ey = convert::to_float(l_dy[l] >> 8) / 256.0
    let den = ddx * ey - ddy * ex
    if den == 0.0 { return -1.0 }
    let qx = ax - x1
    let qy = ay - y1
    let t = (qx * ey - qy * ex) / den
    let u = (qx * ddy - qy * ddx) / den
    if t < 0.0 or t > 1.0 or u < 0.0 or u > 1.0 { return -1.0 }
    t
}

fn use_lines() {
    let fi = pangle >> 19
    let x2 = px + 64 * fixed::finesine[fi + 2048]
    let y2 = py + 64 * fixed::finesine[fi]
    let fx = convert::to_float(px >> 8) / 256.0
    let fy = convert::to_float(py >> 8) / 256.0
    let ddx = convert::to_float((x2 - px) >> 8) / 256.0
    let ddy = convert::to_float((y2 - py) >> 8) / 256.0
    let mut lox = px
    let mut hix = x2
    if x2 < px { lox = x2; hix = px }
    let mut loy = py
    let mut hiy = y2
    if y2 < py { loy = y2; hiy = py }
    validcount++
    let vc = validcount
    let mut n = 0
    for bx in ((lox - bm_ox) >> 23)..(((hix - bm_ox) >> 23) + 1) {
        for by in ((loy - bm_oy) >> 23)..(((hiy - bm_oy) >> 23) + 1) {
            if bx < 0 or by < 0 or bx >= bm_w or by >= bm_h { continue }
            for l in bm_lists[by * bm_w + bx] {
                if l_valid[l] == vc { continue }
                l_valid[l] = vc
                let t = seg_cross(l, fx, fy, ddx, ddy)
                if t >= 0.0 and n < 64 {
                    use_l[n] = l
                    use_t[n] = t
                    n++
                }
            }
        }
    }
    for k in 0..n {
        let mut best = k
        for j in (k + 1)..n {
            if use_t[j] < use_t[best] { best = j }
        }
        let l = use_l[best]
        use_l[best] = use_l[k]
        use_t[best] = use_t[k]
        use_l[k] = l
        if l_special[l] != 0 {
            if point_on_line_side(px, py, l) == 0 { use_special(l) }
            return ()
        }
        let b = l_back[l]
        if b < 0 { return () }
        let f = l_front[l]
        let mut opentop = s_ceil[f]
        if s_ceil[b] < opentop { opentop = s_ceil[b] }
        let mut openbottom = s_floor[f]
        if s_floor[b] > openbottom { openbottom = s_floor[b] }
        if opentop <= openbottom { return () }
    }
    ()
}

fn door_tick(d: int) {
    let s = d_sector[d]
    let dir = d_dir[d]
    if dir == 0 {
        d_count[d] -= 1
        if d_count[d] <= 0 { d_dir[d] = -1 }
        return ()
    }
    if dir == -1 {
        let old = s_ceil[s]
        let dest = s_floor[s]
        if old - d_speed[d] < dest {
            set_ceiling(s, dest)
            let _ = change_sector(s)
            d_live[d] = 0
            s_door[s] = -1
            return ()
        }
        set_ceiling(s, old - d_speed[d])
        if change_sector(s) {
            set_ceiling(s, old)
            let _ = change_sector(s)
            d_dir[d] = 1
        }
        return ()
    }
    let top = d_topz[d]
    if s_ceil[s] + d_speed[d] > top {
        set_ceiling(s, top)
        let _ = change_sector(s)
        if d_stay[d] != 0 {
            d_live[d] = 0
            s_door[s] = -1
        } else {
            d_dir[d] = 0
            d_count[d] = 150
        }
        return ()
    }
    set_ceiling(s, s_ceil[s] + d_speed[d])
    let _ = change_sector(s)
    ()
}

pub fn tic(forward: int, side: int, turn: int, use_btn: bool) {
    cmd_fwd = forward
    cmd_side = side
    cmd_turn = turn
    cmd_use = use_btn
    run_player()
    leveltime++
}

fn run_player() {
    pangle = (pangle + (cmd_turn << 16)) & 0xFFFFFFFF
    if pz <= pfloorz {
        if cmd_fwd != 0 { thrust(pangle, cmd_fwd * 2048) }
        if cmd_side != 0 { thrust(pangle - 0x40000000, cmd_side * 2048) }
    }
    calc_height()
    if cmd_use {
        if not use_down {
            use_lines()
            use_down = true
        }
    } else {
        use_down = false
    }
    xy_movement()
    z_movement()
    for d in 0..32 {
        if d_live[d] != 0 { door_tick(d) }
    }
    for p in 0..16 {
        if lf_live[p] != 0 { lift_tick(p) }
    }
    ()
}

pub fn player_x() -> int { px }
pub fn player_y() -> int { py }
pub fn player_z() -> int { pz }
pub fn player_angle() -> int { pangle }
pub fn player_viewz() -> int { pviewz }
pub fn player_momx() -> int { pmomx }
pub fn player_momy() -> int { pmomy }
pub fn player_floorz() -> int { pfloorz }
pub fn player_sector() -> int { sector_at(px, py) }
pub fn level_time() -> int { leveltime }
pub fn door_count() -> int { doors_opened }
pub fn lift_count() -> int { lifts_started }
pub fn crossed_count() -> int { lines_crossed }
pub fn moves_count() -> int { moves_tried }
pub fn slide_count() -> int { slides }
pub fn sector_ceiling(s: int) -> int { s_ceil[s] }
pub fn sector_floor(s: int) -> int { s_floor[s] }
