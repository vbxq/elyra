// needs modules/sdl built per docs/native-modules.md and copied next to this file as sdl.so
needs std::bytes as bytes
needs std::sys
needs println from std::io
needs sdl
needs render
needs engine

fn present_frame(pixels: int, palette: int) -> bool {
    let uploaded = match bytes::copy_from_vec(pixels, 0, render::framebuffer()) {
        Ok(_) => sdl::present_indexed(pixels, palette),
        Err(e) => Err(e),
    }
    let mut quit = false
    let mut ev = sdl::poll()
    while ev != 0 {
        if ev == 1 { quit = true }
        ev = sdl::poll()
    }
    uploaded.is_ok() and not quit
}

let wad_path = engine::flag_value("--wad", "/home/vbxq/.local/share/elyra-runs/assets/fd/freedoom-0.13.0/freedoom1.wad")
let g = engine::load(wad_path)
if sdl::open("Elyra E1M1", 320, 200, 3).is_err() {
    println("sdl::open failed")
    sys::exit(1)
}
let pixels = bytes::alloc(64000)
let palette = bytes::alloc(768)
let mut first_palette: Vec<int> = vec![0; 768]
for i in 0..768 { first_palette[i] = g.playpal[i] }
let _ = bytes::copy_from_vec(palette, 0, first_palette)
let present = fn() -> bool { present_frame(pixels, palette) }
if engine::has_flag("--timedemo") {
    engine::run_timedemo(present)
} else {
    engine::run_realtime(present)
}
sdl::close()
