// needs modules/sdl built per docs/native-modules.md and copied next to this file as sdl.so
needs std::sys
needs println from std::io
needs screen
needs engine

let wad_path = engine::flag_value("--wad", "/home/vbxq/.local/share/elyra-runs/assets/fd/freedoom-0.13.0/freedoom1.wad")
let g = engine::load(wad_path)
match screen::open("Elyra E1M1", g.playpal) {
    Ok(_) => (),
    Err(e) => {
        println("sdl: {e}")
        sys::exit(1)
    },
}
if engine::has_flag("--timedemo") {
    engine::run_timedemo(screen::present)
} else {
    engine::run_realtime(screen::present)
}
screen::close()
