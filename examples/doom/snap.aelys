use std::sys
use std::fs as fs
use std::bytes
use wad
use map
use gfx
use fixed
use render

fn view(n: int, x: int, y: int, angle_deg: int, pal: Vec<int>, outdir: string) {
    let fx = x << 16
    let fy = y << 16
    let z = render::floor_height_at(fx, fy) + (41 << 16)
    let a = (angle_deg * 4294967296 / 360) & 0xFFFFFFFF
    let t = time::timer()
    render::render_frame(fx, fy, z, a)
    let ms = time::elapsed(t) * 1000.0
    println("view {n} at {x},{y} angle {angle_deg}: {ms} ms, {render::frame_stats()}")
    match render::write_ppm("{outdir}/snap_{n}.ppm", pal) {
        Ok(_) => (),
        Err(e) => println("snap: {e}"),
    }
}

let path = match sys::arg(0) {
    Some(p) => p,
    None => "/home/vbxq/.local/share/elyra-runs/assets/fd/freedoom-0.13.0/freedoom1.wad",
}
let outdir = match sys::arg(1) {
    Some(p) => p,
    None => "/home/vbxq/.local/share/elyra-runs/engine",
}

let w = Wad::open(path)
let mut level = map::load_level(w, "E1M1")
let g = gfx::load_graphics(w)
render::setup(w, g, level)
let pal = render::palette_rgb(g)
let mut rgb: Vec<int> = vec![0; 64000]

let mut p1 = level.things[0]
for t in level.things {
    if t.kind == 1 { p1 = t }
}
view(0, p1.x, p1.y, p1.angle, pal, outdir)
view(1, 1700, 1700, 300, pal, outdir)
view(2, 2296, -384, 90, pal, outdir)
view(3, 700, 1976, 180, pal, outdir)
view(4, 1136, -424, 0, pal, outdir)
view(5, 2200, 1500, 200, pal, outdir)

let frames = 30
let sx = p1.x << 16
let sy = p1.y << 16
let sz = render::floor_height_at(sx, sy) + (41 << 16)
let sa = (p1.angle * 4294967296 / 360) & 0xFFFFFFFF
render::reset_times()
let t_frames = time::timer()
let mut worst = 0.0
for i in 0..frames {
    let tf = time::timer()
    render::render_frame(sx, sy, sz, sa)
    let ms = time::elapsed(tf) * 1000.0
    if ms > worst { worst = ms }
}
let total = time::elapsed(t_frames) * 1000.0
let t_pal = time::timer()
for i in 0..frames { render::to_rgb(pal, rgb) }
let pal_ms = time::elapsed(t_pal) * 1000.0 / (frames as float)
let n = frames as float
println("timing {frames} frames at start view: render_frame avg {total / n} ms (worst {worst} ms)")
println("  bsp+walls {render::time_bsp_ms() / n} ms, planes {render::time_planes_ms() / n} ms, sprites+masked {render::time_masked_ms() / n} ms, palette->rgb {pal_ms} ms")
