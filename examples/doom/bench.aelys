needs std::sys
needs wad
needs map
needs gfx
needs fixed
needs render

let frames = match sys::arg(0) {
    Some(s) => match convert::parse_int(s) {
        Some(n) => n,
        None => 30,
    },
    None => 30,
}
let w = Wad::open("/home/vbxq/.local/share/elyra-runs/assets/fd/freedoom-0.13.0/freedoom1.wad")
let mut level = map::load_level(w, "E1M1")
let g = gfx::load_graphics(w)
render::setup(w, g, level)
let pal = render::palette_rgb(g)
let mut rgb: Vec<int> = vec![0; 64000]
let mut p1 = level.things[0]
for t in level.things {
    if t.kind == 1 { p1 = t }
}
let vx = [p1.x, 1700, 2296, 700, 1136, 2200]
let vy = [p1.y, 1700, -384, 1976, -424, 1500]
let va = [p1.angle, 300, 90, 180, 0, 200]
render::reset_times()
let t0 = time::timer()
for i in 0..frames {
    let v = i % 6
    let sx = vx[v] << 16
    let sy = vy[v] << 16
    let sz = render::floor_height_at(sx, sy) + (41 << 16)
    render::render_frame(sx, sy, sz, (va[v] * 4294967296 / 360) & 0xFFFFFFFF)
    if sys::arg(1) != Some("nopal") { render::to_rgb(pal, rgb) }
}
let n = convert::to_float(frames)
if frames > 0 {
    println("frames {frames} avg {time::elapsed(t0) * 1000.0 / n} ms bsp+walls {render::time_bsp_ms() / n} planes {render::time_planes_ms() / n} masked {render::time_masked_ms() / n}")
}
