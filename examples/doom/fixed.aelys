needs std::math as math
needs std::convert as convert

fn int_abs(a: int) -> int {
    if a < 0 { -a } else { a }
}

pub fn fixed_div(a: int, b: int) -> int {
    if (int_abs(a) >> 14) >= int_abs(b) {
        if (a ^ b) < 0 { return -2147483648 }
        return 2147483647
    }
    a.shl_div(b, 16)
}

pub fn ang(a: int) -> int { a & 0xFFFFFFFF }
pub fn ang_add(a: int, b: int) -> int { (a + b) & 0xFFFFFFFF }
pub fn ang_sub(a: int, b: int) -> int { (a - b) & 0xFFFFFFFF }
pub fn fine_index(a: int) -> int { (a & 0xFFFFFFFF) >> 19 }

fn make_finesine() -> Vec<int> {
    let mut t: Vec<int> = vec![0; 10240]
    for i in 0..10240 {
        let a = (convert::to_float(i) + 0.5) * 2.0 * math::PI / 8192.0
        t[i] = convert::to_int(math::sin(a) * 65536.0)
    }
    t
}

fn make_finetangent() -> Vec<int> {
    let mut t: Vec<int> = vec![0; 4096]
    for i in 0..4096 {
        let a = (convert::to_float(i - 2048) + 0.5) * math::PI / 4096.0
        t[i] = convert::to_int(math::tan(a) * 65536.0)
    }
    t
}

fn make_tantoangle() -> Vec<int> {
    let mut t: Vec<int> = vec![0; 2049]
    for i in 0..2049 {
        let a = math::atan(convert::to_float(i) / 2048.0)
        t[i] = convert::to_int(a / (2.0 * math::PI) * 4294967296.0)
    }
    t
}

pub let finesine = make_finesine()
pub let finetangent = make_finetangent()
pub let tantoangle = make_tantoangle()

pub fn fine_sin(i: int) -> int { finesine[i] }
pub fn fine_cos(i: int) -> int { finesine[i + 2048] }

fn make_viewangletox() -> Vec<int> {
    let focal = fixed_div(160 << 16, finetangent[2048 + 1024])
    let mut t: Vec<int> = vec![0; 4096]
    for i in 0..4096 {
        let ft = finetangent[i]
        let mut x = 0
        if ft > 131072 {
            x = -1
        } else {
            if ft < -131072 {
                x = 321
            } else {
                x = ((160 << 16) - ft.mul_shr(focal, 16) + 65535) >> 16
                if x < -1 { x = -1 }
                if x > 321 { x = 321 }
            }
        }
        t[i] = x
    }
    t
}

let raw_viewangletox = make_viewangletox()

fn make_xtoviewangle() -> Vec<int> {
    let mut t: Vec<int> = vec![0; 321]
    for x in 0..321 {
        let mut i = 0
        while raw_viewangletox[i] > x { i++ }
        t[x] = ((i << 19) - 0x40000000) & 0xFFFFFFFF
    }
    t
}

fn clamp_viewangletox() -> Vec<int> {
    let mut t: Vec<int> = vec![0; 4096]
    for i in 0..4096 {
        let x = raw_viewangletox[i]
        if x == -1 {
            t[i] = 0
        } else {
            if x == 321 { t[i] = 320 } else { t[i] = x }
        }
    }
    t
}

pub let xtoviewangle = make_xtoviewangle()
pub let viewangletox = clamp_viewangletox()
pub let clipangle = xtoviewangle[0]
