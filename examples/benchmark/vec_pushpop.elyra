use std::io
use std::time

let n = 1000000
io::print("Vec push/pop benchmark (n=" + n.to_string() + ")")

let mut v = vec![]

let t1 = time::timer()
let mut i = 0
while i < n {
    v.push(i)
    i = i + 1
}
let push_time = time::elapsed_ms(t1)
io::print("Push time: " + push_time.to_string() + "ms")
io::print("Final len: " + v.len().to_string())

let t2 = time::timer()
while v.len() > 0 {
    let _ = v.pop()
}
let pop_time = time::elapsed_ms(t2)
io::print("Pop time: " + pop_time.to_string() + "ms")
io::print("Final len: " + v.len().to_string())
