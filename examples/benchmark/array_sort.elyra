use std::io
use std::time

fn fill_descending(n: int) {
    let mut arr = vec![]
    let mut i = n
    while i > 0 {
        arr.push(i)
        i = i - 1
    }
    return arr
}

fn bubble_sort(mut arr) {
    let n = arr.len()
    let mut i = 0
    while i < n - 1 {
        let mut j = 0
        while j < n - i - 1 {
            if arr[j] > arr[j + 1] {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

let n = 5000
io::print("Bubble sort benchmark (n=" + n.to_string() + ")")

let mut arr = fill_descending(n)
io::print("Array filled (worst case: descending)")

let t = time::timer()
bubble_sort(arr)
let elapsed = time::elapsed_ms(t)

io::print("Sort time: " + elapsed.to_string() + "ms")
io::print("First 5: " + arr[0].to_string() + " " + arr[1].to_string() + " " + arr[2].to_string() + " " + arr[3].to_string() + " " + arr[4].to_string())
