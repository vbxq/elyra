use std::io
use std::time

fn fill_array(n: int) {
    let mut arr = vec![]
    let mut i = 0
    while i < n {
        arr.push(i)
        i = i + 1
    }
    return arr
}

fn sum_array(arr) -> int {
    let mut sum = 0
    let mut i = 0
    let len = arr.len()
    while i < len {
        sum = sum + arr[i]
        i = i + 1
    }
    return sum
}

let n = 1000000
io::print("Array sum benchmark (n=" + n.to_string() + ")")

let t1 = time::timer()
let arr = fill_array(n)
let fill_time = time::elapsed_ms(t1)
io::print("Fill time: " + fill_time.to_string() + "ms")

let t2 = time::timer()
let sum = sum_array(arr)
let sum_time = time::elapsed_ms(t2)
io::print("Sum time: " + sum_time.to_string() + "ms")
io::print("Sum: " + sum.to_string())
