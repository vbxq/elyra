enum Token {
    Num(float),
    Ident(string),
    Op(char),
    LParen,
    RParen,
    Comma,
    Assign,
}

struct Spanned { tok: Token, col: int, text: string }

enum CalcError {
    UnexpectedChar { col: int, ch: char },
    UnexpectedToken { col: int, found: string },
    BadNumber { col: int, text: string },
    UnexpectedEnd,
    UnknownVar(string),
    UnknownFunc(string),
    DivByZero,
    BadArity { name: string, expected: int, got: int },
    Domain { name: string, arg: float },
}

impl Display for CalcError {
    fn to_display(self) -> string {
        match self {
            CalcError::UnexpectedChar { col, ch } => "column {col}: unexpected character '{ch}'",
            CalcError::UnexpectedToken { col, found } => "column {col}: unexpected '{found}'",
            CalcError::BadNumber { col, text } => "column {col}: malformed number '{text}'",
            CalcError::UnexpectedEnd => "unexpected end of input",
            CalcError::UnknownVar(name) => "unknown variable '{name}'",
            CalcError::UnknownFunc(name) => "unknown function '{name}'",
            CalcError::DivByZero => "division by zero",
            CalcError::BadArity { name, expected, got } => {
                let plural = if expected == 1 { "argument" } else { "arguments" }
                "{name}() takes {expected} {plural}, got {got}"
            }
            CalcError::Domain { name, arg } => "{name}() is undefined for {arg}",
        }
    }
}

enum Expr {
    Num(float),
    Var(string),
    Neg(Expr),
    Bin { op: char, lhs: Expr, rhs: Expr },
    Call { name: string, args: Vec<Expr> },
}

enum Stmt {
    Let { name: string, value: Expr },
    Eval(Expr),
}

fn is_ident_start(c: char) -> bool { c.is_alpha() or c == '_' }

fn is_ident_char(c: char) -> bool { c.is_alphanumeric() or c == '_' }

fn punctuation(c: char) -> Option<Token> {
    match c {
        '+' | '-' | '*' | '/' | '^' => Some(Token::Op(c)),
        '(' => Some(Token::LParen),
        ')' => Some(Token::RParen),
        ',' => Some(Token::Comma),
        '=' => Some(Token::Assign),
        _ => None,
    }
}

fn tokenize(src: string) -> Result<Vec<Spanned>, CalcError> {
    let chars = src.chars()
    let mut out: Vec<Spanned> = vec![]
    let mut i = 0
    while i < chars.len() {
        let c = chars[i]
        let col = i + 1
        if c.is_whitespace() {
            i++
        } else if c.is_digit() or c == '.' {
            let mut text = ""
            while i < chars.len() and (chars[i].is_digit() or chars[i] == '.') {
                text.push(chars[i])
                i++
            }
            let value = convert::parse_float(text).ok_or(CalcError::BadNumber { col: col, text: text })?
            out.push(Spanned { tok: Token::Num(value), col: col, text: text })
        } else if is_ident_start(c) {
            let mut name = ""
            while i < chars.len() and is_ident_char(chars[i]) {
                name.push(chars[i])
                i++
            }
            out.push(Spanned { tok: Token::Ident(name), col: col, text: name })
        } else {
            let tok = punctuation(c).ok_or(CalcError::UnexpectedChar { col: col, ch: c })?
            out.push(Spanned { tok: tok, col: col, text: string::from_char(c) })
            i++
        }
    }
    Ok(out)
}

struct Parser { toks: Vec<Spanned>, pos: int }

impl Parser {
    fn new(toks: Vec<Spanned>) -> Parser { Parser { toks: toks, pos: 0 } }

    fn peek(self) -> Option<Token> {
        match self.toks.get(self.pos) {
            Some(s) => Some(s.tok),
            None => None,
        }
    }

    fn peek_is_op(self, op: char) -> bool {
        self.peek() == Some(Token::Op(op))
    }

    fn next(mut self) -> Result<Spanned, CalcError> {
        let s = self.toks.get(self.pos).ok_or(CalcError::UnexpectedEnd)?
        self.pos++
        Ok(s)
    }

    fn unexpected(self) -> CalcError {
        match self.toks.get(self.pos) {
            Some(s) => CalcError::UnexpectedToken { col: s.col, found: s.text },
            None => CalcError::UnexpectedEnd,
        }
    }

    fn consume(mut self, want: Token) -> Result<unit, CalcError> {
        if self.peek() == Some(want) {
            self.pos++
            Ok(())
        } else {
            Err(self.unexpected())
        }
    }

    fn ident(mut self) -> Result<string, CalcError> {
        let s: Spanned = self.next()?
        match s.tok {
            Token::Ident(name) => Ok(name),
            _ => Err(CalcError::UnexpectedToken { col: s.col, found: s.text }),
        }
    }

    fn let_binding(mut self) -> Result<Stmt, CalcError> {
        self.pos++
        let name = self.ident()?
        self.consume(Token::Assign)?
        Ok(Stmt::Let { name: name, value: self.expr()? })
    }

    fn statement(mut self) -> Result<Stmt, CalcError> {
        let is_let = self.peek() == Some(Token::Ident("let"))
        let stmt = if is_let { self.let_binding()? } else { Stmt::Eval(self.expr()?) }
        if self.pos < self.toks.len() {
            return Err(self.unexpected())
        }
        Ok(stmt)
    }

    fn expr(mut self) -> Result<Expr, CalcError> {
        let mut lhs = self.term()?
        while self.peek_is_op('+') or self.peek_is_op('-') {
            let op = if self.peek_is_op('+') { '+' } else { '-' }
            self.pos++
            let rhs = self.term()?
            lhs = Expr::Bin { op: op, lhs: lhs, rhs: rhs }
        }
        Ok(lhs)
    }

    fn term(mut self) -> Result<Expr, CalcError> {
        let mut lhs = self.unary()?
        while self.peek_is_op('*') or self.peek_is_op('/') {
            let op = if self.peek_is_op('*') { '*' } else { '/' }
            self.pos++
            let rhs = self.unary()?
            lhs = Expr::Bin { op: op, lhs: lhs, rhs: rhs }
        }
        Ok(lhs)
    }

    fn unary(mut self) -> Result<Expr, CalcError> {
        if self.peek_is_op('-') {
            self.pos++
            return Ok(Expr::Neg(self.unary()?))
        }
        self.power()
    }

    fn power(mut self) -> Result<Expr, CalcError> {
        let base = self.atom()?
        if self.peek_is_op('^') {
            self.pos++
            let exponent = self.unary()?
            return Ok(Expr::Bin { op: '^', lhs: base, rhs: exponent })
        }
        Ok(base)
    }

    fn atom(mut self) -> Result<Expr, CalcError> {
        let s: Spanned = self.next()?
        match s.tok {
            Token::Num(n) => Ok(Expr::Num(n)),
            Token::Ident(name) => self.variable_or_call(name),
            Token::LParen => {
                let inner = self.expr()?
                self.consume(Token::RParen)?
                Ok(inner)
            }
            _ => Err(CalcError::UnexpectedToken { col: s.col, found: s.text }),
        }
    }

    fn variable_or_call(mut self, name: string) -> Result<Expr, CalcError> {
        if self.peek() != Some(Token::LParen) {
            return Ok(Expr::Var(name))
        }
        self.pos++
        Ok(Expr::Call { name: name, args: self.arguments()? })
    }

    fn arguments(mut self) -> Result<Vec<Expr>, CalcError> {
        let mut args: Vec<Expr> = vec![]
        if self.peek() == Some(Token::RParen) {
            self.pos++
            return Ok(args)
        }
        args.push(self.expr()?)
        while self.peek() == Some(Token::Comma) {
            self.pos++
            args.push(self.expr()?)
        }
        self.consume(Token::RParen)?
        Ok(args)
    }
}

fn parse(src: string) -> Result<Stmt, CalcError> {
    let mut parser = Parser::new(tokenize(src)?)
    parser.statement()
}

fn check_arity(name: string, args: Vec<float>, expected: int) -> Result<unit, CalcError> {
    if args.len() != expected {
        return Err(CalcError::BadArity { name: name, expected: expected, got: args.len() })
    }
    Ok(())
}

fn call(name: string, args: Vec<float>) -> Result<float, CalcError> {
    match name {
        "sqrt" => {
            check_arity(name, args, 1)?
            if args[0] < 0.0 {
                return Err(CalcError::Domain { name: name, arg: args[0] })
            }
            Ok(math::sqrt(args[0]))
        }
        "abs" => {
            check_arity(name, args, 1)?
            Ok(math::abs(args[0]))
        }
        "max" => {
            check_arity(name, args, 2)?
            Ok(math::max(args[0], args[1]))
        }
        "min" => {
            check_arity(name, args, 2)?
            Ok(math::min(args[0], args[1]))
        }
        _ => Err(CalcError::UnknownFunc(name)),
    }
}

fn eval(e: Expr, env: Map<string, float>) -> Result<float, CalcError> {
    match e {
        Expr::Num(n) => Ok(n),
        Expr::Var(name) => env.get(name).ok_or(CalcError::UnknownVar(name)),
        Expr::Neg(inner) => Ok(-eval(inner, env)?),
        Expr::Bin { op, lhs, rhs } => {
            let a = eval(lhs, env)?
            let b = eval(rhs, env)?
            match op {
                '+' => Ok(a + b),
                '-' => Ok(a - b),
                '*' => Ok(a * b),
                '/' => if b == 0.0 { Err(CalcError::DivByZero) } else { Ok(a / b) },
                _ => Ok(math::pow(a, b)),
            }
        }
        Expr::Call { name, args } => {
            let mut values: Vec<float> = vec![]
            for arg in args {
                values.push(eval(arg, env)?)
            }
            call(name, values)
        }
    }
}

fn run_line(line: string, mut env: Map<string, float>) -> Result<string, CalcError> {
    let stmt: Stmt = parse(line)?
    match stmt {
        Stmt::Let { name, value } => {
            let v = eval(value, env)?
            env[name] = v
            Ok("{name} = {v}")
        }
        Stmt::Eval(e) => Ok("{eval(e, env)?}"),
    }
}

let script = vec![
    "1 + 2 * 3",
    "(1 + 2) * 3",
    "2 ^ 3 ^ 2",
    "-2 ^ 2",
    "2 ^ -1",
    "10 / 4 - 0.5",
    "let r = 1.5",
    "let area = pi * r ^ 2",
    "area / pi",
    "sqrt(16) + max(2, 7) * min(3, 4)",
    "abs(-3.25) - --1",
    "let x = sqrt(2)",
    "x * x",
    "0.1 + 0.2",
    "1 / (3 - 3)",
    "2 * y + 1",
    "max(1)",
    "sqrt(1, 2)",
    "sqrt(-4)",
    "max()",
    "floor(2.5)",
    "3 + $ 4",
    "(1 + 2",
    "4 + * 5",
    "1.2.3 + 1",
    "let 5 = 3",
    "7 7",
    "let total = area + x - r",
    "total",
]

let mut env: Map<string, float> = Map::new()
env["pi"] = math::PI
for line in script {
    println("> {line}")
    match run_line(line, env) {
        Ok(text) => println(text),
        Err(e) => println("error: {e}"),
    }
}
