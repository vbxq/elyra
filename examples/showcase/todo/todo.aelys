needs std::fs
needs std::sys

struct Task { id: int, prio: int, text: string, done: bool }

enum Action {
    Added(int),
    Completed(int),
    Removed { index: int, task: Task },
}

enum Command {
    Add { prio: int, text: string },
    Done(int),
    Remove(int),
    List,
    Stats,
    Undo,
}

enum TodoError {
    UnknownCommand(string),
    MissingArgument { command: string, what: string },
    NotANumber { what: string, got: string },
    NoSuchTask(int),
    AlreadyDone(int),
    NothingToUndo,
}

impl Display for TodoError {
    fn to_display(self) -> string {
        match self {
            TodoError::UnknownCommand(word) => "unknown command '{word}'",
            TodoError::MissingArgument { command, what } => "'{command}' needs {what}",
            TodoError::NotANumber { what, got } => "{what} must be a number, got '{got}'",
            TodoError::NoSuchTask(id) => "no task #{id}",
            TodoError::AlreadyDone(id) => "task #{id} is already done",
            TodoError::NothingToUndo => "nothing to undo",
        }
    }
}

fn number(what: string, word: string) -> Result<int, TodoError> {
    convert::parse_int(word).ok_or(TodoError::NotANumber { what: what, got: word })
}

fn task_id(command: string, words: Vec<string>) -> Result<int, TodoError> {
    if words.len() < 2 {
        return Err(TodoError::MissingArgument { command: command, what: "a task id" })
    }
    number("task id", words[1])
}

fn parse_command(line: string) -> Result<Command, TodoError> {
    let words = line.split(" ")
    let name = words[0]
    match name {
        "add" => {
            if words.len() < 3 {
                return Err(TodoError::MissingArgument { command: name, what: "a priority and a text" })
            }
            let prio = number("priority", words[1])?
            Ok(Command::Add { prio: prio, text: words[2..].join(" ") })
        }
        "done" => Ok(Command::Done(task_id(name, words)?)),
        "rm" => Ok(Command::Remove(task_id(name, words)?)),
        "list" => Ok(Command::List),
        "stats" => Ok(Command::Stats),
        "undo" => Ok(Command::Undo),
        _ => Err(TodoError::UnknownCommand(name)),
    }
}

fn right(text: string, width: int) -> string { text.pad_left(width, " ") }

fn left(text: string, width: int) -> string { text.pad_right(width, " ") }

fn status(t: Task) -> string { if t.done { "done" } else { "open" } }

fn list_order(a: Task, b: Task) -> int {
    if a.done != b.done {
        return if a.done { 1 } else { -1 }
    }
    if a.prio != b.prio {
        return b.prio - a.prio
    }
    a.id - b.id
}

struct Project { tasks: Vec<Task>, history: Vec<Action>, next_id: int }

impl Project {
    fn new() -> Project { Project { tasks: vec![], history: vec![], next_id: 1 } }

    fn index_of(self, id: int) -> Result<int, TodoError> {
        for i in 0..self.tasks.len() {
            if self.tasks[i].id == id {
                return Ok(i)
            }
        }
        Err(TodoError::NoSuchTask(id))
    }

    fn add(mut self, prio: int, text: string) {
        let id = self.next_id
        self.next_id++
        self.tasks.push(Task { id: id, prio: prio, text: text, done: false })
        self.history.push(Action::Added(id))
        println("added #{id} (prio {prio}): {text}")
    }

    fn complete(mut self, id: int) -> Result<unit, TodoError> {
        let i = self.index_of(id)?
        if self.tasks[i].done {
            return Err(TodoError::AlreadyDone(id))
        }
        self.tasks[i].done = true
        self.history.push(Action::Completed(id))
        println("completed #{id}: {self.tasks[i].text}")
        Ok(())
    }

    fn remove(mut self, id: int) -> Result<unit, TodoError> {
        let index = self.index_of(id)?
        let task = self.tasks.remove(index)
        println("removed #{id}: {task.text}")
        self.history.push(Action::Removed { index: index, task: task })
        Ok(())
    }

    fn undo(mut self) -> Result<unit, TodoError> {
        let action: Action = self.history.pop().ok_or(TodoError::NothingToUndo)?
        match action {
            Action::Added(id) => {
                let task = self.tasks.remove(self.index_of(id)?)
                println("undo: dropped #{id} ({task.text})")
            }
            Action::Completed(id) => {
                let i = self.index_of(id)?
                self.tasks[i].done = false
                println("undo: reopened #{id}")
            }
            Action::Removed { index, task } => {
                self.tasks.insert(index, task)
                println("undo: restored #{task.id}")
            }
        }
        Ok(())
    }

    fn list(self) {
        if self.tasks.is_empty() {
            println("(no tasks)")
            return
        }
        let mut rows = self.tasks.clone()
        rows.sort_by(list_order)
        let mut width = 4
        for t in rows {
            width = math::max(width, t.text.char_len())
        }
        println("{right("ID", 3)}  {right("PRIO", 4)}  {left("STATUS", 6)}  TASK")
        println("{"-".repeat(3)}  {"-".repeat(4)}  {"-".repeat(6)}  {"-".repeat(width)}")
        for t in rows {
            println("{right("{t.id}", 3)}  {right("{t.prio}", 4)}  {left(status(t), 6)}  {t.text}")
        }
    }

    fn stats(self) {
        let total = self.tasks.len()
        let mut done = 0
        let mut load = 0
        for t in self.tasks {
            if t.done { done++ } else { load += t.prio }
        }
        let percent = if total == 0 { 0 } else { done * 100 / total }
        println("stats: {total} tasks, {done} done, {total - done} open, {percent}% complete, open priority load {load}")
    }

    fn execute(mut self, cmd: Command) -> Result<unit, TodoError> {
        match cmd {
            Command::Add { prio, text } => self.add(prio, text),
            Command::Done(id) => self.complete(id)?,
            Command::Remove(id) => self.remove(id)?,
            Command::List => self.list(),
            Command::Stats => self.stats(),
            Command::Undo => self.undo()?,
        }
        Ok(())
    }

    fn run_line(mut self, line: string) -> Result<unit, TodoError> {
        let cmd = parse_command(line)?
        self.execute(cmd)
    }
}

fn run(path: string) -> Result<int, string> {
    let text = fs::read_text(path)?
    let mut project = Project::new()
    let mut errors = 0
    let lines = text.lines()
    for n in 0..lines.len() {
        let line = lines[n].trim()
        if line.is_empty() or line.starts_with("#") {
            continue
        }
        match project.run_line(line) {
            Ok(_) => (),
            Err(e) => {
                errors++
                println("line {n + 1}: {e}")
            }
        }
    }
    Ok(errors)
}

match sys::arg(0) {
    Some(path) => match run(path) {
        Ok(errors) => println("finished with {errors} errors"),
        Err(e) => {
            eprintln("todo: cannot read {path}: {e}")
            sys::exit(1)
        }
    },
    None => {
        eprintln("usage: todo <commands-file>")
        sys::exit(2)
    }
}
