use std::io

fn stack_demo() {
    let mut stack = vec![]

    io::print("Push 10, 20, 30:")
    stack.push(10)
    stack.push(20)
    stack.push(30)
    io::print("Stack size: " + stack.len().to_string())

    io::print("Pop all:")
    while stack.len() > 0 {
        let val = stack.pop().unwrap_or(0)
        io::print("  Popped: " + val.to_string())
    }
    io::print("Stack size: " + stack.len().to_string())
}

stack_demo()
