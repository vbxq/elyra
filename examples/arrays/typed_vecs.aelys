use std::io

let mut v = vec![1, 2, 3]
io::print("Vec<Int> initial: len = " + v.len().to_string())

v.push(4)
v.push(5)
v.push(6)
io::print("After 3 pushes: len = " + v.len().to_string())

let popped = v.pop().unwrap_or(0)
io::print("Popped: " + popped.to_string())

let mut i = 0
while i < v.len() {
    io::print("  v[" + i.to_string() + "] = " + v[i].to_string())
    i = i + 1
}

let mut floats = vec![1.1, 2.2, 3.3]
floats.push(4.4)
io::print("vec![3] = " + floats[3].to_string())

let mut flags = vec![true, true]
flags.push(false)
io::print("vec![2] = " + flags[2].to_string())
