use std::io

let mut arr = [10, 20, 30, 40, 50]
io::print("Array: [10, 20, 30, 40, 50]")
io::print("Length: " + arr.len().to_string())
io::print("arr[0] = " + arr[0].to_string())
io::print("arr[2] = " + arr[2].to_string())

arr[2] = 999
io::print("After arr[2] = 999: arr[2] = " + arr[2].to_string())

let floats = [1.5, 2.5, 3.5]
io::print("Float array[1] = " + floats[1].to_string())

let bools = [true, false, true]
io::print("Bool array[0] = " + bools[0].to_string())
