use std::io

fn bubble_sort(mut arr) {
    let n = arr.len()
    let mut i = 0
    while i < n - 1 {
        let mut j = 0
        while j < n - i - 1 {
            if arr[j] > arr[j + 1] {
                let tmp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = tmp
            }
            j = j + 1
        }
        i = i + 1
    }
}

fn print_array(arr) {
    let mut s = "["
    let mut i = 0
    while i < arr.len() {
        if i > 0 { s = s + ", " }
        s = s + arr[i].to_string()
        i = i + 1
    }
    io::print(s + "]")
}

let mut arr = [64, 34, 25, 12, 22, 11, 90]
io::print("Before sort:")
print_array(arr)

bubble_sort(arr)

io::print("After sort:")
print_array(arr)
